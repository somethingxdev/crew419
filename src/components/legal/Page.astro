---
interface Props {
  title: string;
}

const { title } = Astro.props;
const headingId = `${title.toLowerCase().replace(/\s+/g, '-')}-heading`;
---

<section class="pt-32 pb-24 xl:pt-[169px] xl:pb-30" aria-labelledby={headingId}>
  <div class="container">
    <div class="flex flex-col items-start gap-7.5">
      <h1 id={headingId} class="text-4xl leading-[1.1] font-bold md:text-5xl xl:text-[52px]">{title}</h1>
      <p class="max-w-131.75 text-lg leading-none font-medium">
        <slot>Text</slot>
      </p>
    </div>
  </div>
</section>
