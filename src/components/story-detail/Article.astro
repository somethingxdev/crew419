---
import type { CollectionEntry } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';
import { Prose } from '@/shared/ui/prose';

interface Props {
  entry: CollectionEntry<'stories'>;
}

type StoryData = CollectionEntry<'stories'>['data'];

const typeLabels: Record<StoryData['type'], string> = {
  'trip-recap': 'Trip recap',
  testimony: 'Testimony',
  'ministry-update': 'Ministry update',
};

const { title, type, published_on, date_label, excerpt, hero_image, hero_image_alt, body, inline_image, inline_image_alt } = Astro.props.entry.data;

// `inline_image` is rendered as an optimized <CmsImage> at the spot where the rich text
// references it (`<img src="…/assets/<id>">`); if the body does not reference it, it follows the body.
const inlineImageTag = new RegExp(`<img\\b[^>]*/assets/${inline_image.id}[^>]*>`, 'g');
const [bodyBefore, ...bodyRest] = body.split(inlineImageTag);
const bodyAfter = bodyRest.join('');
---

<article class="pt-32 pb-15 md:pb-20 xl:pt-52" aria-labelledby="story-heading">
  <div class="container">
    <header class="flex flex-col items-center gap-7.5">
      <div class="flex w-full max-w-200 flex-col items-center gap-7.5 text-center">
        <h1 id="story-heading" class="text-4xl font-bold md:text-5xl xl:text-[52px]">{title}</h1>
        <div class="text-muted-foreground flex items-center justify-center gap-2.5 text-base leading-none">
          <p class="font-bold uppercase">{typeLabels[type]}</p>
          <span class="bg-muted-foreground size-1.5 shrink-0 rounded-full" aria-hidden="true"></span>
          <time datetime={published_on}>{date_label}</time>
        </div>
        <p class="max-w-145 text-lg leading-none font-medium opacity-80">{excerpt}</p>
      </div>

      <div class="bg-cream h-64 w-full rounded-lg p-1.25 sm:h-96 xl:h-150">
        <CmsImage image={hero_image} alt={hero_image_alt} widths={[800, 1600, 2400]} loading="eager" class="size-full rounded-lg object-cover" />
      </div>
    </header>

    <Prose class="mx-auto mt-15 w-full max-w-200 md:mt-20">
      <Fragment set:html={bodyBefore} />

      <div class="not-sw-prose bg-cream h-60 w-full rounded-lg p-1.25 sm:h-115">
        <CmsImage image={inline_image} alt={inline_image_alt} widths={[800, 1600]} class="size-full rounded-lg object-cover" />
      </div>

      <Fragment set:html={bodyAfter} />
    </Prose>
  </div>
</article>
