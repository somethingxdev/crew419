---
import { getCollection, type CollectionEntry } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';
import { storyDate, STORY_TYPE_LABELS } from '@/lib/story';

interface Props {
  entry: CollectionEntry<'stories'>;
}

type StoryData = CollectionEntry<'stories'>['data'];


const { entry } = Astro.props;
const stories = await getCollection('stories', ({ id }) => id !== entry.id);
---

{
  stories.length > 0 && (
    <section class="py-15" aria-labelledby="more-stories-heading">
      <div class="container">
        <div class="mx-auto flex max-w-222.5 flex-col items-center gap-4 text-center">
          <p class="text-muted-foreground text-base leading-none font-bold uppercase">More from the mission field</p>
          <h2 id="more-stories-heading" class="text-3xl  font-bold md:text-5xl">
            Discover More Stories of Transformation
          </h2>
        </div>

        <ul class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
          {stories.map(({ data: story }) => (
            <li>
              <article class="bg-cream flex h-full flex-col gap-5 rounded-lg px-4 pt-4 pb-5">
                <CmsImage image={story.card_image} alt={story.title} widths={[400, 800]} class="h-65 w-full shrink-0 rounded-lg object-cover" />
                <div class="flex flex-1 flex-col gap-5">
                  <div class="flex flex-col gap-2.5">
                    <p class="text-muted-foreground text-base leading-none font-bold uppercase">{STORY_TYPE_LABELS[story.type]}</p>
                    <h3 class="line-clamp-2 text-2xl  font-bold">{story.title}</h3>
                  </div>
                  <p class="text-muted-foreground text-base leading-none">{storyDate(story.published_on)}</p>
                </div>
                <a
                  href={`/stories/${story.slug}`}
                  class="text-muted-foreground border-muted-foreground hover:text-foreground hover:border-foreground self-start border-b pb-2 text-base leading-none font-black uppercase transition-colors"
                >
                  Read story
                </a>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
