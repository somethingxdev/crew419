---
import { Image } from 'astro:assets';
import bg from '@/assets/images/cta/bg-2.png';
import { SITE_LINKS } from '@/lib/links';
import { Button } from '@/shared/ui/button';

// Static CTA — the same on every story page, so it is not editable in the CMS.
const title = 'Inspired by This Story?';
const text = 'Your next step could be joining a future mission team, serving alongside local churches, and becoming part of the next story God is writing.';
---

<section class="py-15" aria-labelledby="story-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <Image src={bg} alt="" widths={[1600]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-155 flex-col items-center justify-center px-5 py-15 text-center text-cream md:py-0">
        <h2 id="story-cta-heading" class="text-3xl  font-bold md:text-5xl">{title}</h2>
        <p class="mt-6 max-w-92 text-base leading-none">{text}</p>
        <div class="mt-7.5 flex w-full flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <Button href={SITE_LINKS.call.href} variant="cream" size="lg" class="w-82.5 max-w-full">{SITE_LINKS.call.label}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
