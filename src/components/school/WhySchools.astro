---
import { getSingleton } from '@/lib/content';

const {
  school_intro_eyebrow: eyebrow,
  school_intro_heading: heading,
  school_intro_text: text,
  school_challenge_cards: cards,
} = await getSingleton('website_content');
---

<section class="relative z-20 py-30" aria-labelledby="why-schools-heading">
  <div class="container flex flex-col items-center gap-12.5">
    <div class="flex max-w-195 flex-col items-center gap-7.5 text-center">
      <div class="flex flex-col items-center gap-4">
        <p class="text-muted-foreground leading-none font-bold uppercase">{eyebrow}</p>
        <h2 id="why-schools-heading" class="text-3xl font-bold md:text-5xl">{heading}</h2>
      </div>
      <p class="max-w-130 leading-none">{text}</p>
    </div>

    <div class="grid w-full gap-5 md:grid-cols-2 xl:grid-cols-4">
      {
        cards.map((item) => (
          <article class="bg-cream flex min-h-60 flex-col justify-between gap-7.5 rounded-lg p-7.5">
            <h3 class="text-2xl font-bold">{item.title}</h3>
            <p class="text-lg leading-none font-medium">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
