---
import { Image } from 'astro:assets';
import decorBottom from '@/assets/images/decor-bottom.png';
import decorTop from '@/assets/images/decor-top.png';
import bg from '@/assets/images/school/why-bg.png';

const features = [
  {
    num: '01',
    title: 'Student-Focused Itineraries',
    text: 'Every trip is tailored to your school’s goals, schedule, and the needs of your students.',
  },
  {
    num: '02',
    title: 'Safe & Organized Travel',
    text: 'Our experienced team manages logistics so teachers can focus on leading and mentoring students.',
  },
  {
    num: '03',
    title: 'Local Ministry Partnerships',
    text: 'Students serve alongside trusted local churches and ministries that create lasting Kingdom impact.',
  },
  {
    num: '04',
    title: 'Leadership Development',
    text: 'Mission trips help students grow in faith, confidence, compassion, and servant leadership.',
  },
];
---

<section class="relative z-10 py-15 md:py-30 lg:py-37.5" aria-labelledby="why-crew419-school-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[1600, 2400]} class="size-full object-cover" />
    <div class="absolute inset-0 bg-black/10"></div>
  </div>

  <div class="container">
    <div class="relative z-10 flex w-full flex-col justify-between gap-10 xl:flex-row xl:items-start">
      <div class="flex max-w-215 flex-col gap-7.5 text-cream">
        <div class="flex flex-col gap-3.75">
          <p class="leading-none font-bold uppercase opacity-80">Why crew419</p>
          <h2 id="why-crew419-school-heading" class="text-3xl font-bold text-shadow-2xs md:text-5xl">Everything You Need for a Meaningful Student Mission Trip</h2>
        </div>
        <p class="max-w-131 text-lg leading-none font-medium">
          We partner with Christian schools to create safe, organized, and Christ-centered mission experiences that help students grow while serving communities around the world.
        </p>
      </div>

      <div class="flex w-full max-w-130 shrink-0 flex-col gap-5">
        {
          features.map((item) => (
            <article class="flex flex-col gap-5 rounded-lg bg-cream p-7.5">
              <div class="flex flex-col gap-3.75">
                <p class="text-primary text-2xl font-bold">{item.num}</p>
                <h3 class="text-2xl font-bold">{item.title}</h3>
              </div>
              <p class="leading-none">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute top-5 left-0 z-10 w-full -translate-y-1/2">
    <Image src={decorTop} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
  <div class="pointer-events-none absolute bottom-5 left-0 z-10 w-full translate-y-[70%]">
    <Image src={decorBottom} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
</section>
