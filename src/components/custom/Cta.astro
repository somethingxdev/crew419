---
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

const {
  custom_cta_title: title,
  custom_cta_text: text,
  custom_cta_image: image,
  custom_cta_primary_label: primaryLabel,
  custom_cta_primary_href: primaryHref,
  custom_cta_secondary_label: secondaryLabel,
  custom_cta_secondary_href: secondaryHref,
} = await getSingleton('website_content');

const paragraphs = text.split(/\n\s*\n/);
---

<section class="py-15" aria-labelledby="custom-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <CmsImage image={image} alt="" widths={[1600]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-155 flex-col items-center justify-center gap-7.5 px-5 py-15 text-center text-cream md:py-0">
        <div class="flex flex-col items-center gap-6">
          <h2 id="custom-cta-heading" class="text-3xl  font-bold md:text-5xl">{title}</h2>
          <div class="flex flex-col gap-2.5 leading-none">
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>

        <div class="flex flex-col items-center gap-4 sm:flex-row">
          <Button href={primaryHref} variant="cream">{primaryLabel}</Button>
          <Button href={secondaryHref} variant="glass">{secondaryLabel}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
