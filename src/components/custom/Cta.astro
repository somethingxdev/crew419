---
import { Image } from 'astro:assets';
import bg from '@/assets/images/cta/bg-3.png';
import { Button } from '@/shared/ui/button';

// Static CTA — the same on every visit, so it is not editable in the CMS.
const title = 'Let’s Build a Mission That Fits Your Calling';
const text = 'Your church or school doesn’t need to fit into someone else’s itinerary.\n\nLet’s create a mission experience designed specifically for your people, your goals, and the community you’re called to serve.';
const primaryLabel = 'Book a 30–minute call';
const primaryHref = '/contact';
const secondaryLabel = 'Explore Mission Trips';
const secondaryHref = '/trips';

const paragraphs = text.split(/\n\s*\n/);
---

<section class="py-15" aria-labelledby="custom-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <Image src={bg} alt="" widths={[1600]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-155 flex-col items-center justify-center gap-7.5 px-5 py-15 text-center text-cream md:py-0">
        <div class="flex flex-col items-center gap-6">
          <h2 id="custom-cta-heading" class="text-3xl  font-bold md:text-5xl">{title}</h2>
          <div class="flex flex-col gap-2.5 leading-none">
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>

        <div class="flex flex-col items-center gap-4 sm:flex-row">
          <Button href={primaryHref} variant="cream">{primaryLabel}</Button>
          <Button href={secondaryHref} variant="glass">{secondaryLabel}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
