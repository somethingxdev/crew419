---
import { Image } from 'astro:assets';
import bg from '@/assets/images/custom/cta-bg.png';
import { Button } from '@/shared/ui/button';
---

<section class="py-15" aria-labelledby="custom-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <Image src={bg} alt="" widths={[1600]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-155 flex-col items-center justify-center gap-7.5 px-5 py-15 text-center text-cream md:py-0">
        <div class="flex flex-col items-center gap-6">
          <h2 id="custom-cta-heading" class="text-3xl  font-bold md:text-5xl">Let’s Build a Mission That Fits Your Calling</h2>
          <div class="flex flex-col gap-2.5 leading-none">
            <p>Your church or school doesn’t need to fit into someone else’s itinerary.</p>
            <p>Let’s create a mission experience designed specifically for your people, your goals, and the community you’re called to serve.</p>
          </div>
        </div>

        <div class="flex flex-col items-center gap-4 sm:flex-row">
          <Button href="/contact" variant="cream">Book a 30–minute call</Button>
          <Button href="/trips" variant="glass">Explore Mission Trips</Button>
        </div>
      </div>
    </div>
  </div>
</section>
