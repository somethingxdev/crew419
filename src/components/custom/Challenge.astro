---
import { getSingleton } from '@/lib/content';

const { custom_intro_eyebrow: eyebrow, custom_intro_heading: heading, custom_intro_text: text } = await getSingleton('website_content');

// Body paragraphs, with the final paragraph rendered as the emphasized conclusion.
const paragraphs = text.split(/\n\s*\n/);
const conclusion = paragraphs.pop();
---

<section class="relative z-30 py-30" aria-labelledby="challenge-heading">
  <div class="container">
    <p class="text-muted-foreground leading-none font-bold uppercase">{eyebrow}</p>
    <div class="mt-4 flex flex-col gap-10 xl:flex-row xl:items-start xl:gap-36">
      <h2 id="challenge-heading" class="max-w-134 shrink-0 text-3xl font-bold xl:text-5xl">{heading}</h2>
      <div class="flex w-full max-w-133 flex-col gap-10">
        <div class="flex flex-col gap-2.5 leading-tight">
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <p class="text-lg leading-tight font-medium">{conclusion}</p>
      </div>
    </div>
  </div>
</section>
