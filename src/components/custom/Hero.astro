---
import { Image } from 'astro:assets';
import decor from '@/assets/images/decor-bottom.png';
import bg from '@/assets/images/custom/hero-bg.png';
import { Button } from '@/shared/ui/button';
---

<section class="relative flex min-h-150 flex-col pt-20 xl:min-h-221 xl:pt-26" aria-labelledby="custom-hero-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[800, 1600, 2400]} loading="eager" class="size-full object-cover" />
    <div class="absolute inset-0 bg-black/10"></div>
  </div>

  <div class="relative container w-full py-15 xl:pt-24 xl:pb-20">
    <div class="flex w-full flex-col items-center text-center xl:items-start xl:text-left">
      <p class="leading-none font-bold text-cream/80 uppercase">Custom mission experiences</p>
      <h1 id="custom-hero-heading" class="mt-3 max-w-297 text-4xl  font-bold text-cream text-shadow-2xs md:text-5xl xl:text-[52px]">
        Mission Trips Built Around Your Churches / Christian Schools / Individuals / Sports Teams Not Around Ours
      </h1>
      <p class="mt-7.5 max-w-137.5 text-lg leading-none font-medium text-cream">
        Crew419 creates customized mission experiences tailored to your team's unique goals, purpose, and communities, avoiding a one-size-fits-all approach. Through trusted partnerships and
        meaningful service, we design trips that fit your specific vision and deliver a lasting impact.
      </p>
      <div class="mt-7.5 flex w-full max-w-137.5 flex-col gap-4 sm:flex-row">
        <Button href="/contact" variant="cream" size="lg" class="flex-1">Book a 30–minute call</Button>
        <Button href="#how-it-works" variant="glass" size="lg" class="flex-1">See how it works</Button>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute -bottom-5 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto w-full" />
  </div>
</section>
