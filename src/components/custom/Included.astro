---
import SectionHeading from '@/components/shared/SectionHeading.astro';
import { getSingleton } from '@/lib/content';

const {
  custom_included_eyebrow: eyebrow,
  custom_included_heading: heading,
  custom_included_items: items,
} = await getSingleton('website_content');
---

<section class="py-30" aria-labelledby="included-heading">
  <div class="container">
    <SectionHeading id="included-heading" {eyebrow} {heading} class="mx-auto max-w-177" />

    <ul class="mt-12.5 flex flex-wrap items-center justify-center gap-5">
      {items.map((item) => <li class="bg-cream rounded-2xl px-7.5 pt-7.5 pb-6 leading-none font-bold uppercase">{item}</li>)}
    </ul>
  </div>
</section>
