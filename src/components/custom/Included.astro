---
const items = [
  'Mission Planning',
  'Destination Selection',
  'Trusted Ministry Partnerships',
  'Travel Coordination',
  'Accommodation Planning',
  'Discipleship Materials',
  'Leader Support',
  'Safety Guidance',
  'Fundraising Resources',
];
---

<section class="py-15 md:py-30" aria-labelledby="included-heading">
  <div class="container">
    <div class="mx-auto flex max-w-177 flex-col items-center gap-4 text-center">
      <p class="text-muted-foreground leading-none font-bold uppercase">What’s Included</p>
      <h2 id="included-heading" class="text-3xl  font-bold md:text-5xl">Everything You Need. Nothing You Don’t.</h2>
    </div>

    <ul class="mt-12.5 flex flex-wrap items-center justify-center gap-5">
      {items.map((item) => <li class="bg-cream rounded-2xl px-7.5 pt-7.5 pb-6 leading-none font-bold uppercase">{item}</li>)}
    </ul>
  </div>
</section>
