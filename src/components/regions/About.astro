---
import type { CollectionEntry } from 'astro:content';

interface Props {
  region: CollectionEntry<'regions'>;
}

const { about_heading: heading, about_text: text, facts } = Astro.props.region.data;
---

<section class="py-30" aria-labelledby="about-region-heading">
  <div class="container">
    <div class="mx-auto flex max-w-122 flex-col items-center gap-7.5 text-center">
      <div class="flex flex-col gap-4">
        <p class="text-muted-foreground leading-none font-bold uppercase">About the region</p>
        <h2 id="about-region-heading" class="text-3xl font-bold md:text-5xl">{heading}</h2>
      </div>
      <p class="leading-none">{text}</p>
    </div>

    <div class="mt-12.5 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {
        facts.map((fact) => (
          <article class="bg-cream flex h-45 flex-col justify-between rounded-lg p-7.5">
            <h3 class="text-muted-foreground text-2xl  font-bold">{fact.title}</h3>
            <p class="text-lg leading-none font-medium">{fact.value}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
