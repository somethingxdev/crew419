---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '@/components/shared/SectionHeading.astro';

interface Props {
  region: CollectionEntry<'regions'>;
}

const { about_heading: heading, about_text: text, facts } = Astro.props.region.data;
---

<section class="py-15 md:py-30" aria-labelledby="about-region-heading">
  <div class="container">
    <SectionHeading id="about-region-heading" eyebrow="About the region" {heading} {text} class="mx-auto max-w-122" />

    <div class="mt-12.5 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {
        facts.map((fact) => (
          <article class="bg-cream flex gap-10 flex-col justify-between rounded-lg p-7.5">
            <h3 class="text-muted-foreground text-2xl  font-bold">{fact.title}</h3>
            <p class="text-lg leading-none font-medium">{fact.value}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
