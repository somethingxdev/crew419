---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArrowLeft from '@tabler/icons/outline/arrow-left.svg';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import CmsImage from '@/components/base/CmsImage.astro';
import { Button } from '@/shared/ui/button';

interface Props {
  region: CollectionEntry<'regions'>;
  eyebrow?: string;
  heading?: string;
  class?: string;
}

const { region, eyebrow = 'Real Stories', heading = 'Featured Stories from This Region', class: className = 'py-30' } = Astro.props;

const stories = await getCollection('stories', ({ data }) => data.region.id === region.id);

const typeLabels: Record<CollectionEntry<'stories'>['data']['type'], string> = {
  'trip-recap': 'Trip Recap',
  testimony: 'Testimony',
  'ministry-update': 'Ministry Update',
};

// Alternating card layout (decorative).
const layouts = [
  { photoClass: 'rotate-5', pairClass: 'sm:items-center', itemClass: '' },
  { photoClass: '-rotate-3', pairClass: 'sm:items-end', itemClass: 'sm:mt-9' },
];
---

{
  stories.length > 0 && (
    <section class:list={['relative z-20', className]} aria-labelledby="region-stories-heading" data-region-stories>
      <div class="container max-w-[1520px]">
        <div class="relative">
          <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
            <p class="text-muted-foreground leading-none font-bold uppercase">{eyebrow}</p>
            <h2 id="region-stories-heading" class="text-3xl  font-bold md:text-5xl">{heading}</h2>
          </div>

          <div class="mt-6 flex justify-center gap-4 lg:absolute lg:right-12 lg:bottom-0 lg:mt-0">
            <Button type="button" variant="secondary" size="icon" aria-label="Previous story" data-region-stories-prev>
              <ArrowLeft />
            </Button>
            <Button type="button" variant="secondary" size="icon" aria-label="Next story" data-region-stories-next>
              <ArrowRight />
            </Button>
          </div>
        </div>

        <div class="mt-10 py-8" data-region-stories-viewport>
          <ul class="flex w-max min-w-full touch-pan-y items-start justify-between gap-8" data-region-stories-container>
            {stories.map(({ data: story }, index) => {
              const layout = layouts[index % layouts.length];
              return (
                <li class:list={['min-w-0 shrink-0', layout.itemClass]}>
                  <div class:list={['relative isolate flex items-center', layout.pairClass]}>
                    <article class="relative z-10 flex w-[min(480px,calc(100vw-2.5rem))] flex-col rounded-sm bg-cream p-5 shadow-[0_4px_7.5px_rgba(0,0,0,0.2)]">
                      <p class="text-muted-foreground leading-none font-bold uppercase">{typeLabels[story.type]}</p>
                      <h3 class="mt-2.5 text-2xl  font-bold">{story.title}</h3>
                      <p class="mt-6 leading-none">{story.excerpt}</p>
                      <div class="mt-7.5 flex items-center justify-between">
                        <p class="text-muted-foreground leading-none">{story.date_label}</p>
                        <a
                          href={`/stories/${story.slug}`}
                          class="text-muted-foreground border-muted-foreground hover:text-foreground hover:border-foreground border-b pb-2 leading-none font-black uppercase transition-colors"
                        >
                          Read story
                        </a>
                      </div>
                    </article>
                    <figure
                      class:list={[
                        'relative z-0 -ml-22 hidden h-112.5 w-87.5 shrink-0 rounded-sm bg-cream p-2.5 shadow-[0_4px_7.5px_rgba(0,0,0,0.2)] sm:block',
                        layout.photoClass,
                      ]}
                    >
                      <CmsImage image={story.card_image} alt={story.card_image_alt} widths={[800]} class="size-full rounded-sm object-cover" />
                    </figure>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>

        <div class="mt-12.5 flex justify-center">
          <Button href="/stories" size="lg" class="w-82.5 max-w-full">View All stories</Button>
        </div>
      </div>
    </section>
  )
}

<script>
  import EmblaCarousel from 'embla-carousel';

  const section = document.querySelector<HTMLElement>('[data-region-stories]');
  const viewport = section?.querySelector<HTMLElement>('[data-region-stories-viewport]');
  const prev = section?.querySelector<HTMLButtonElement>('[data-region-stories-prev]');
  const next = section?.querySelector<HTMLButtonElement>('[data-region-stories-next]');

  if (section && viewport && prev && next) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const embla = EmblaCarousel(viewport, {
      align: 'start',
      containScroll: 'trimSnaps',
      duration: reduced ? 0 : 25,
      watchDrag: !reduced,
    });

    const toggleButtons = () => {
      prev.disabled = !embla.canScrollPrev();
      next.disabled = !embla.canScrollNext();
    };

    prev.addEventListener('click', () => embla.scrollPrev());
    next.addEventListener('click', () => embla.scrollNext());
    embla.on('select', toggleButtons);
    embla.on('reInit', toggleButtons);
    toggleButtons();
  }
</script>
