---
import type { CollectionEntry } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';
import { Button } from '@/shared/ui/button';

interface Props {
  region: CollectionEntry<'regions'>;
}

const {
  cta_title: title,
  cta_text: text,
  cta_image: bg,
  cta_primary_label: primaryLabel,
  cta_primary_href: primaryHref,
  cta_secondary_label: secondaryLabel,
  cta_secondary_href: secondaryHref,
} = Astro.props.region.data;
---

<section class="py-15" aria-labelledby="region-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <CmsImage image={bg} alt="" widths={[1600]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-158 flex-col items-center justify-center px-5 py-15 text-center text-cream md:py-0">
        <h2 id="region-cta-heading" class="text-3xl  font-bold md:text-5xl">{title}</h2>
        <p class="mt-6 max-w-90 leading-none">{text}</p>
        <Button href={primaryHref} variant="cream" size="lg" class="mt-7.5 w-82.5 max-w-full">{primaryLabel}</Button>
        {
          secondaryLabel && secondaryHref && (
            <Button href={secondaryHref} variant="glass" size="lg" class="mt-4 w-82.5 max-w-full">
              {secondaryLabel}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>
