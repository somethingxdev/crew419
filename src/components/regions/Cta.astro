---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import bg from '@/assets/images/cta/bg-3.png';
import { SITE_LINKS } from '@/lib/links';
import { Button } from '@/shared/ui/button';

interface Props {
  region: CollectionEntry<'regions'>;
}

const { name } = Astro.props.region.data;

// Static CTA — only the region name changes, so the copy is not editable in the CMS.
const text = 'Explore upcoming trips or talk with our team to find the mission that’s right for you.';
---

<section class="py-15" aria-labelledby="region-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <Image src={bg} alt="" widths={[1600]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-155 flex-col items-center justify-center px-5 py-15 text-center text-cream md:py-0">
        <h2 id="region-cta-heading" class="text-3xl  font-bold md:text-5xl">Ready to Serve in {name}?</h2>
        <p class="mt-7.5 max-w-137.5 leading-tight">{text}</p>
        <div class="mt-7.5 flex w-full max-w-133 flex-col gap-4 sm:flex-row">
          <Button href={SITE_LINKS.call.href} variant="cream" size="lg" class="flex-1">{SITE_LINKS.call.label}</Button>
          <Button href={SITE_LINKS.destinations.href} variant="glass" size="lg" class="flex-1">{SITE_LINKS.destinations.label}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
