---
import { Image } from 'astro:assets';
import decor from '@/assets/images/decor-bottom.png';
import bg from '@/assets/images/regions/africa/hero-bg.png';
import map from '@/assets/images/regions/africa/map.png';
import { Button } from '@/shared/ui/button';
---

<section class="relative flex min-h-150 flex-col pt-20 xl:min-h-226 xl:pt-26" aria-labelledby="region-hero-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[800, 1600, 2400]} loading="eager" class="size-full object-cover object-bottom" />
    <div class="absolute inset-0 bg-black/15"></div>
  </div>

  <div class="relative container w-full py-15 xl:pt-24 xl:pb-20">
    <div class="flex w-full items-start justify-between">
      <div class="flex w-full max-w-155 flex-col items-center text-center xl:items-start xl:text-left">
        <p class="leading-none font-bold text-cream/80 uppercase">Discover Africa</p>
        <h1 id="region-hero-heading" class="mt-3 text-4xl font-bold text-cream text-shadow-2xs md:text-6xl xl:text-7xl">
          <span class="block">Serve across</span>
          <span class="block uppercase xl:text-[72px]">Africa</span>
        </h1>
        <p class="mt-7.5 max-w-137.5 text-lg leading-none font-medium text-cream">
          From growing churches to underserved communities, Africa offers unique opportunities to share the Gospel, build relationships, and support local ministries through meaningful service.
        </p>
        <div class="mt-7.5 flex w-full max-w-137.5 flex-col gap-4 sm:flex-row">
          <Button href="/contact" variant="cream" size="lg" class="flex-1">Book a 30–minute call</Button>
          <Button href="/trips#destinations" variant="glass" size="lg" class="flex-1">Find Your Destination</Button>
        </div>
      </div>

      <Image src={map} alt="" widths={[640, 1280]} class="hidden w-2/5 max-w-159 xl:-mt-16 xl:block" />
    </div>
  </div>

  <div class="pointer-events-none absolute -bottom-5 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto w-full" />
  </div>
</section>
