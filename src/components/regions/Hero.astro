---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import decor from '@/assets/images/decor-bottom.png';
import CmsImage from '@/components/base/CmsImage.astro';
import { SITE_LINKS } from '@/lib/links';
import { Button } from '@/shared/ui/button';

interface Props {
  region: CollectionEntry<'regions'>;
}

const { name, hero_title: title, hero_description: description, hero_image: bg, map_image: map } = Astro.props.region.data;

// "Serve across\nAfrica" → first line regular, the rest uppercase.
const lines = title.split('\n');
---

<section class="relative flex min-h-150 flex-col pt-20 xl:min-h-226 xl:pt-26" aria-labelledby="region-hero-heading">
  <div class="absolute inset-0 overflow-hidden">
    <CmsImage image={bg} alt="" widths={[800, 1600, 2400]} loading="eager" class="size-full object-cover object-bottom" />
    <div class="absolute inset-0 bg-black/15"></div>
  </div>

  <div class="relative container w-full py-15 xl:pt-24 xl:pb-20">
    <div class="flex w-full items-start justify-between">
      <div class="flex w-full max-w-155 flex-col items-center text-center xl:items-start xl:text-left">
        <p class="leading-none font-bold text-cream/80 uppercase">Discover {name}</p>
        <h1 id="region-hero-heading" class="mt-3 text-4xl font-bold text-cream text-shadow-2xs md:text-6xl xl:text-7xl">
          {lines.map((line, index) => <span class:list={['block', index > 0 && 'uppercase xl:text-[72px]']}>{line}</span>)}
        </h1>
        <p class="mt-7.5 max-w-137.5 text-lg leading-none font-medium text-cream">{description}</p>
        <div class="mt-7.5 flex w-full max-w-137.5 flex-col gap-4 sm:flex-row">
          <Button href={SITE_LINKS.call.href} variant="cream" size="lg" class="flex-1">{SITE_LINKS.call.label}</Button>
          <Button href={SITE_LINKS.destinations.href} variant="glass" size="lg" class="flex-1">{SITE_LINKS.destinations.label}</Button>
        </div>
      </div>

      <CmsImage image={map} alt="" widths={[640, 1280]} class="hidden w-2/5 max-w-159 xl:-mt-16 xl:block" />
    </div>
  </div>

  <div class="pointer-events-none absolute -bottom-5 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto w-full" />
  </div>
</section>
