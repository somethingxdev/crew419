---
import CmsImage from '@/components/base/CmsImage.astro';
import LifeInMission from '@/components/home/LifeInMission.astro';
import Facebook from '@/icons/facebook.svg';
import Instagram from '@/icons/instragram.svg';
import Youtube from '@/icons/youtube.svg';
import { getSingleton } from '@/lib/content';
import { getNavigation } from './nav';

const { logo, site_name, tagline, copyright, facebook_url, instagram_url, youtube_url } = await getSingleton('global');
const nav = await getNavigation('footer');

const columns = [
  { title: 'Mission Trips', links: nav.mission_trips },
  { title: 'Resources', links: nav.resources },
  { title: 'About', links: nav.about },
  { title: 'Connect', links: nav.connect },
];
const legal = nav.legal;
---

<LifeInMission />

<footer class="pb-10 pt-15">
  <div class="container">
    <div class="flex justify-between">
      <div class="w-96">
        <a href="/">
          <CmsImage image={logo} alt={site_name} widths={[221, 442]} class="h-18 w-auto" />
        </a>
        <p class="mt-8 text-lg leading-none font-medium">{tagline}</p>
        <div class="mt-8 flex gap-3">
          {
            (
              [
                { href: facebook_url, label: 'Facebook', Icon: Facebook },
                { href: instagram_url, label: 'Instagram', Icon: Instagram },
                { href: youtube_url, label: 'YouTube', Icon: Youtube },
              ] as const
            ).map(
              ({ href, label, Icon }) =>
                href && (
                  <a
                    href={href}
                    aria-label={label}
                    target="_blank"
                    rel="noopener"
                    class="flex size-12 items-center justify-center rounded-lg bg-card hover:-translate-y-0.5 transition-all duration-300"
                  >
                    <Icon />
                  </a>
                ),
            )
          }
        </div>
      </div>

      <nav class="flex items-start gap-12">
        {
          columns.map((column) => (
            <div class="w-48 last:w-auto">
              <p class="leading-none font-bold text-muted-foreground uppercase mb-6">{column.title}</p>
              <ul class="space-y-3">
                {column.links.map((item) => (
                  <li>
                    <a href={item.href} class="text-lg leading-none font-medium  hover:text-primary">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-12 flex items-center justify-between text-lg leading-none font-medium">
      <p>{copyright}</p>
      <div class="flex gap-25">
        {
          legal.map((item) => (
            <a href={item.href} class="hover:text-primary transition-colors">
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
