---
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

const {
  individuals_cta_title: title,
  individuals_cta_text: text,
  individuals_cta_image: image,
  individuals_cta_primary_label: primaryLabel,
  individuals_cta_primary_href: primaryHref,
  individuals_cta_secondary_label: secondaryLabel,
  individuals_cta_secondary_href: secondaryHref,
} = await getSingleton('website_content');
---

<section class="py-15" aria-labelledby="individuals-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <CmsImage image={image} alt="" widths={[1600, 3000]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-203 flex-col items-center justify-center gap-7.5 px-5 py-15 text-center text-cream md:py-0">
        <div class="flex w-full flex-col items-center gap-6">
          <h2 id="individuals-cta-heading" class="max-w-167 text-3xl font-bold md:text-5xl">{title}</h2>
          <p class="max-w-112 leading-none">{text}</p>
        </div>
        <div class="flex flex-col items-center gap-4 sm:flex-row">
          <Button href={primaryHref} variant="cream" size="lg">{primaryLabel}</Button>
          <Button href={secondaryHref} variant="glass" size="lg" class="w-62 max-w-full">{secondaryLabel}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
