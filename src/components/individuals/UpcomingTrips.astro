---
import { Image, type LocalImageProps } from 'astro:assets';
import costaRica from '@/assets/images/individuals/trip-costa-rica.png';
import dominican from '@/assets/images/individuals/trip-dominican.png';
import zambiaCommunity from '@/assets/images/individuals/trip-zambia-community.png';
import zambiaSports from '@/assets/images/individuals/trip-zambia-sports.png';

interface Trip {
  category: string;
  title: string;
  date: string;
  price: string;
  duration: string;
  href: string;
  image: LocalImageProps['src'];
  alt: string;
}

const trips: Trip[] = [
  {
    category: 'Sports',
    title: 'Costa Rica Sports Mission',
    date: 'July 8–17',
    price: 'From $1,850',
    duration: '10 Days',
    href: '/trips',
    image: costaRica,
    alt: 'Kids playing soccer on a field in Costa Rica',
  },
  {
    category: 'Sports',
    title: 'Zambia Sports Outreach',
    date: 'July 8–17',
    price: 'From $1,850',
    duration: '10 Days',
    href: '/trips',
    image: zambiaSports,
    alt: 'A sports outreach gathering in Zambia',
  },
  {
    category: 'General Mission',
    title: 'Zambia Community Mission',
    date: 'July 8–17',
    price: 'From $1,850',
    duration: '10 Days',
    href: '/trips/zambia-community-outreach',
    image: zambiaCommunity,
    alt: 'Volunteers serving a community in Zambia',
  },
  {
    category: 'General Mission',
    title: 'Dominican Republic Community Mission',
    date: 'July 8–17',
    price: 'From $1,850',
    duration: '10 Days',
    href: '/trips',
    image: dominican,
    alt: 'A mission team with children in the Dominican Republic',
  },
];
---

<section class="relative z-20 py-15" aria-labelledby="upcoming-trips-heading">
  <div class="container flex flex-col items-center gap-10">
    <div class="flex max-w-195 flex-col items-center gap-7.5 text-center">
      <div class="flex flex-col items-center gap-4">
        <p class="text-muted-foreground leading-none font-bold uppercase">Upcoming Trips</p>
        <h2 id="upcoming-trips-heading" class="text-3xl font-bold md:text-5xl">Find Your Next Mission Experience</h2>
      </div>
      <p class="max-w-110 leading-none">Explore upcoming trips and discover where you can serve, connect, and make a difference with a Crew419 team.</p>
    </div>

    <div class="grid w-full gap-5 md:grid-cols-2 xl:grid-cols-4">
      {
        trips.map((trip) => (
          <article class="bg-cream flex flex-col items-start justify-between gap-5 rounded-lg p-5">
            <div class="flex w-full flex-col gap-5">
              <Image src={trip.image} alt={trip.alt} widths={[680]} class="h-65 w-full rounded-lg object-cover" />
              <div class="flex flex-col gap-2.5">
                <p class="text-muted-foreground leading-none font-bold uppercase">{trip.category}</p>
                <h3 class="text-2xl font-bold">{trip.title}</h3>
              </div>
              <ul class="flex flex-col gap-2.5 leading-none">
                <li>{trip.date}</li>
                <li>{trip.price}</li>
                <li>{trip.duration}</li>
              </ul>
            </div>
            <a href={trip.href} class="text-muted-foreground border-muted-foreground hover:text-foreground hover:border-foreground border-b pb-2 leading-none font-black uppercase transition-colors">
              View Trip
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
