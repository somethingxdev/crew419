---
import { getCollection, getEntry } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import { getSingleton } from '@/lib/content';
import { tripPath } from '@/lib/links';
import { tripDates, tripDuration, tripSlug } from '@/lib/trip';

const {
  individuals_more_eyebrow: eyebrow,
  individuals_more_heading: heading,
  individuals_more_text: text,
} = await getSingleton('website_content');

const trips = await Promise.all(
  (await getCollection('trips'))
    .sort((a, b) => a.data.start_date.localeCompare(b.data.start_date))
    .map(async ({ data }) => {
      const region = await getEntry(data.region);
      if (!region) throw new Error(`trips/${data.title}: region "${data.region.id}" is not published`);

      const country = await getEntry(data.country);
      if (!country) throw new Error(`trips/${data.title}: country "${data.country.id}" does not exist`);

      return { ...data, region: region.data, href: tripPath(region.data.slug, tripSlug(country.data.name, data.title)) };
    }),
);
---

<section class="relative z-20 py-15" aria-labelledby="upcoming-trips-heading">
  <div class="container flex flex-col items-center gap-10">
    <SectionHeading id="upcoming-trips-heading" {eyebrow} {heading} {text} textClass="max-w-110" class="max-w-195" />

    <div class="grid w-full gap-5 md:grid-cols-2 xl:grid-cols-4">
      {
        trips.map((trip) => (
          <article class="bg-cream flex flex-col items-start justify-between gap-5 rounded-lg p-5">
            <div class="flex w-full flex-col gap-5">
              <CmsImage image={trip.card_image} alt={trip.title} widths={[680]} class="h-65 w-full rounded-lg object-cover" />
              <div class="flex flex-col gap-2.5">
                <p class="text-muted-foreground leading-none font-bold uppercase">{trip.region.name}</p>
                <h3 class="text-2xl font-bold">{trip.title}</h3>
              </div>
              <ul class="flex flex-col gap-2.5 leading-none">
                <li>{tripDates(trip)}</li>
                <li>{trip.price}</li>
                <li>{tripDuration(trip)}</li>
              </ul>
            </div>
            <a href={trip.href} class="text-muted-foreground border-muted-foreground hover:text-foreground hover:border-foreground border-b pb-2 leading-none font-black uppercase transition-colors">
              View Trip
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
