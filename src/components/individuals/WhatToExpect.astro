---
import { getSingleton } from '@/lib/content';

const {
  individuals_features_eyebrow: eyebrow,
  individuals_features_heading: heading,
  individuals_feature_cards: cards,
} = await getSingleton('website_content');
---

<section class="relative z-20 py-30" aria-labelledby="what-to-expect-heading">
  <div class="container flex flex-col items-center gap-12.5">
    <div class="flex max-w-169 flex-col items-center gap-4 text-center">
      <p class="text-muted-foreground leading-none font-bold uppercase">{eyebrow}</p>
      <h2 id="what-to-expect-heading" class="text-3xl font-bold md:text-5xl">{heading}</h2>
    </div>

    <div class="grid w-full gap-5 md:grid-cols-2 xl:grid-cols-4">
      {
        cards.map((item) => (
          <article class="bg-cream flex min-h-49 flex-col justify-between gap-7.5 rounded-lg p-7.5">
            <h3 class="text-muted-foreground text-2xl font-bold">{item.title}</h3>
            <p class="text-lg leading-none font-medium">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
