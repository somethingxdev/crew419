---
import { Image } from 'astro:assets';
import photo1 from '@/assets/images/individuals/why-join-1.png';
import photo2 from '@/assets/images/individuals/why-join-2.png';
import PhotoPairSection from '@/components/shared/PhotoPairSection.astro';
---

<PhotoPairSection labelledBy="why-join-heading" class="py-30">
  <Image slot="image-left" src={photo1} alt="A mission team member smiling with local kids" width={600} height={600} />
  <Image slot="image-right" src={photo2} alt="Volunteers posing together in the field" width={600} height={600} />

  <div class="flex w-full flex-col items-start gap-4">
    <p class="text-muted-foreground leading-none font-bold uppercase">Why Join?</p>
    <h2 id="why-join-heading" class="text-3xl font-bold md:text-5xl">Find Your Place on the Team</h2>
  </div>
  <p class="max-w-130 leading-none">
    Mission isn’t only for groups. Crew419 gives individuals the opportunity to step into meaningful service, build lifelong connections, and use their gifts to share hope through sports and
    ministry.
  </p>
</PhotoPairSection>
