---
import CmsImage from '@/components/base/CmsImage.astro';
import PhotoPairSection from '@/components/shared/PhotoPairSection.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import { getSingleton } from '@/lib/content';

const {
  individuals_intro_eyebrow: eyebrow,
  individuals_intro_heading: heading,
  individuals_intro_text: text,
  individuals_intro_photo_left: photoLeft,
  individuals_intro_photo_right: photoRight,
} = await getSingleton('website_content');
---

<PhotoPairSection labelledBy="why-join-heading" class="py-30">
  <CmsImage slot="image-left" image={photoLeft} alt="A mission team member smiling with local kids" widths={[600, 1200]} />
  <CmsImage slot="image-right" image={photoRight} alt="Volunteers posing together in the field" widths={[600, 1200]} />

  <SectionHeading id="why-join-heading" {eyebrow} {heading} align="start" class="w-full" />
  <p class="max-w-130 leading-none">{text}</p>
</PhotoPairSection>
