---
import { Image } from 'astro:assets';
import bg from '@/assets/images/cta/bg-2.png';
import { SITE_LINKS } from '@/lib/links';
import { Button } from '@/shared/ui/button';

interface Props {
  class?: string;
}

const { class: className = 'py-15' } = Astro.props;

// Static CTA — the same on the travel-guides hub and on every guide, so it is not editable in the CMS.
const title = 'Your Mission Starts With One Step';
const text = "God is already moving around the world.\nLet's discover where He's inviting you to serve.";
---

<section class={className} aria-labelledby="resources-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <Image src={bg} alt="" widths={[1600, 3000]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-155 flex-col items-center justify-center gap-7.5 px-5 py-15 text-center text-cream md:py-0">
        <div class="flex w-full flex-col items-center gap-6">
          <h2 id="resources-cta-heading" class="text-3xl font-bold md:text-5xl">{title}</h2>
          <p class="leading-none whitespace-pre-line">{text}</p>
        </div>
        <div class="flex flex-col items-center gap-4 sm:flex-row">
          <Button href={SITE_LINKS.call.href} variant="cream" size="lg">{SITE_LINKS.call.label}</Button>
          <Button href="/trips" variant="glass" size="lg" class="max-w-full">Explore Mission Trips</Button>
        </div>
      </div>
    </div>
  </div>
</section>
