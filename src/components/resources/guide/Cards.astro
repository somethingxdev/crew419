---
interface Props {
  eyebrow: string;
  heading: string;
  cards: { title: string; text: string }[];
}

const { eyebrow, heading, cards } = Astro.props;
---

<section class="pt-40 pb-15" aria-labelledby="guide-cards-heading">
  <div class="container">
    <div class="mx-auto flex max-w-169 flex-col gap-4 text-center">
      <p class="leading-none font-bold text-muted-foreground uppercase">{eyebrow}</p>
      <h2 id="guide-cards-heading" class="text-3xl leading-none font-bold md:text-5xl">{heading}</h2>
    </div>

    <ul class="mt-12.5 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {
        cards.map((card) => (
          <li class="bg-cream flex min-h-44.5 flex-col justify-between gap-7.5 rounded-lg p-7.5">
            <h3 class="text-2xl font-bold text-muted-foreground">{card.title}</h3>
            <p class="text-lg leading-none font-medium">{card.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
