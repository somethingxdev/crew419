---
import { Image, type LocalImageProps } from 'astro:assets';
import decorBottom from '@/assets/images/decor-bottom.png';
import decorTop from '@/assets/images/decor-top.png';
import photo1 from '@/assets/images/resources/photo-1.png';
import photo2 from '@/assets/images/resources/photo-2.png';
import { Button } from '@/shared/ui/button';

interface Props {
  bg: LocalImageProps['src'];
}

const { bg } = Astro.props;

const fields = [
  { name: 'firstName', placeholder: 'First Name', type: 'text', required: true },
  { name: 'lastName', placeholder: 'Last Name', type: 'text', required: true },
  { name: 'email', placeholder: 'Email', type: 'email', required: true },
  { name: 'organization', placeholder: 'Church / Organization (optional)', type: 'text', required: false },
];
---

<section id="get-your-copy" class="relative my-15 py-25 md:py-40" aria-labelledby="get-your-copy-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[1600, 3000]} class="size-full object-cover" />
  </div>

  <div class="relative container">
    <div class="flex flex-col items-start gap-15 lg:flex-row lg:justify-between">
      <div class="flex w-full max-w-145 flex-col gap-10">
        <div class="flex flex-col gap-4">
          <p class="leading-none font-bold text-muted-foreground uppercase">Get your free copy</p>
          <h2 id="get-your-copy-heading" class="text-3xl leading-none font-bold md:text-5xl">We’ll Send It Straight to Your Inbox</h2>
        </div>

        <form class="flex w-full max-w-120 flex-col gap-7.5">
          <div class="flex flex-col gap-2.5">
            {
              fields.map((field) => (
                <input
                  type={field.type}
                  name={field.name}
                  placeholder={field.placeholder}
                  required={field.required}
                  aria-label={field.placeholder}
                  class="bg-cream w-full rounded-sm border-0 px-5 py-4.5 text-lg leading-none font-medium placeholder:text-muted-foreground focus:ring-2 focus:ring-secondary"
                />
              ))
            }
          </div>
          <Button type="submit" size="lg" class="w-82.5 max-w-full">Download PDF</Button>
        </form>
      </div>

      <div class="relative mx-auto hidden h-120 w-full max-w-140 shrink-0 lg:block" aria-hidden="true">
        <div class="bg-cream absolute top-0 left-0 w-81 -rotate-3 rounded-sm p-3 pb-15 shadow-[0px_4px_7.5px_rgba(0,0,0,0.2)]">
          <Image src={photo1} alt="" width={600} height={600} class="aspect-square w-full rounded-sm object-cover" />
        </div>
        <div class="bg-cream absolute top-50 left-56 w-81 rotate-6 rounded-sm p-3 pb-15 shadow-[0px_4px_7.5px_rgba(0,0,0,0.2)]">
          <Image src={photo2} alt="" width={600} height={450} class="aspect-[300/188] w-full rounded-sm object-cover" />
        </div>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute top-0 left-0 z-10 w-full -translate-y-1/2">
    <Image src={decorTop} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
  <div class="pointer-events-none absolute bottom-0 left-0 z-10 w-full translate-y-[63%]">
    <Image src={decorBottom} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
</section>
