---
import type { CollectionEntry } from 'astro:content';
import Hero from '@/components/shared/Hero.astro';
import { Button } from '@/shared/ui/button';

interface Props {
  resource: CollectionEntry<'resources'>;
}

const {
  hero_image: bg,
  hero_eyebrow: eyebrow,
  hero_title: title,
  hero_description: description,
  hero_primary_label: primaryLabel,
  hero_primary_href: heroPrimaryHref,
  hero_secondary_label: secondaryLabel,
  hero_secondary_href: secondaryHref,
  pdf,
} = Astro.props.resource.data;

// An uploaded PDF is what the primary button downloads; without one the button uses the CMS href (e.g. "#get-your-copy").
const primaryHref = pdf ? pdf.url : heroPrimaryHref;
---

<Hero id="guide-hero" {bg}>
  <Fragment slot="eyebrow">{eyebrow}</Fragment>
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="description">{description}</Fragment>
  <Fragment slot="actions">
    <Button size="lg" href={primaryHref} variant="cream">{primaryLabel}</Button>
    <Button size="lg" href={secondaryHref} variant="glass">{secondaryLabel}</Button>
  </Fragment>
</Hero>
