---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import decor from '@/assets/images/decor-bottom.png';
import CmsImage from '@/components/base/CmsImage.astro';
import { Button } from '@/shared/ui/button';

interface Props {
  resource: CollectionEntry<'resources'>;
}

const {
  hero_image: bg,
  hero_eyebrow: eyebrow,
  hero_title: title,
  hero_description: description,
  hero_primary_label: primaryLabel,
  hero_primary_href: heroPrimaryHref,
  hero_secondary_label: secondaryLabel,
  hero_secondary_href: secondaryHref,
  pdf,
} = Astro.props.resource.data;

// An uploaded PDF is what the primary button downloads; without one the button uses the CMS href (e.g. "#get-your-copy").
const primaryHref = pdf ? pdf.url : heroPrimaryHref;
---

<section class="relative" aria-labelledby="guide-hero-heading">
  <div class="absolute inset-0 overflow-hidden">
    <CmsImage image={bg} alt="" widths={[800, 1600]} loading="eager" class="size-full object-cover" />
    <div class="absolute inset-0 bg-black/10"></div>
  </div>

  <div class="relative container flex w-full flex-1 flex-col justify-between gap-20 py-60">
    <div class="flex w-full max-w-242 flex-col items-center text-center xl:items-start xl:text-left">
      <p class="leading-none font-bold text-cream/80 uppercase">{eyebrow}</p>
      <h1 id="guide-hero-heading" class="mt-3 text-4xl font-bold text-cream text-shadow-2xs md:text-6xl xl:text-[74px]">
        {title}
      </h1>
      <p class="mt-7.5 max-w-156 text-lg leading-none font-medium text-cream">{description}</p>
      <div class="mt-7.5 flex w-full max-w-165 flex-col gap-4 sm:flex-row">
        <Button href={primaryHref} variant="cream" size="lg" class="flex-1">{primaryLabel}</Button>
        <Button href={secondaryHref} variant="glass" size="lg" class="flex-1">{secondaryLabel}</Button>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute -bottom-5 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto w-full" />
  </div>
</section>
