---
import { Button } from '@/shared/ui/button';

interface Props {
  eyebrow: string;
  heading: string;
  text: string;
}

const { eyebrow, heading, text } = Astro.props;
---

<section class="py-15" aria-labelledby="guide-intro-heading">
  <div class="container">
    <div class="mx-auto flex max-w-190 flex-col items-center gap-7.5 text-center">
      <div class="flex flex-col gap-4">
        <p class="leading-none font-bold text-muted-foreground uppercase">{eyebrow}</p>
        <h2 id="guide-intro-heading" class="text-3xl leading-none font-bold md:text-5xl">{heading}</h2>
      </div>
      <p class="max-w-136 leading-none">{text}</p>
      <Button href="#get-your-copy" size="lg" class="w-82.5 max-w-full">Download Guide</Button>
    </div>
  </div>
</section>
