---
import { getCollection } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';

const { resources_hub_grid_heading: heading } = await getSingleton('website_content');
const destinations = await getCollection('resources', ({ data }) => data.kind === 'travel_guide');
---

<section id="destinations" class="pt-40 pb-15" aria-labelledby="destinations-heading">
  <div class="container">
    <h2 id="destinations-heading" class="text-center text-3xl leading-none font-bold md:text-5xl">{heading}</h2>

    <ul class="mt-12.5 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {
        destinations.map(({ data: destination }) => (
          <li class="bg-cream flex flex-col items-start gap-5 rounded-lg p-4 pb-5">
            <CmsImage image={destination.card_image} alt={destination.card_image_alt} widths={[800]} class="h-65 w-full rounded-lg object-cover" />
            <h3 class="text-2xl font-bold">{destination.title}</h3>
            <a
              href={`/resources/travel-guides/${destination.slug}`}
              class="border-muted-foreground text-muted-foreground hover:text-foreground hover:border-foreground border-b pb-2 leading-none font-black uppercase transition-colors"
              aria-label={`View the ${destination.title} travel guide`}
            >
              View Guide
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
