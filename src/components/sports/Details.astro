---
import { Image } from 'astro:assets';
import decorBottom from '@/assets/images/decor-bottom.png';
import decorTop from '@/assets/images/decor-top.png';
import bg from '@/assets/images/sports/details-bg.png';

const features = [
  {
    num: '01',
    title: 'Custom itineraries',
    text: 'Every team is different. We create a mission experience tailored to your goals, group size, interests, and ministry vision.',
  },
  {
    num: '02',
    title: 'International sports partnerships',
    text: 'Connect with local athletes, coaches, and communities through trusted partnerships built around sports and service.',
  },
  {
    num: '03',
    title: 'Travel logistics',
    text: 'From transportation and accommodations to schedules and on-the-ground support, we handle the details from start to finish.',
  },
  {
    num: '04',
    title: 'Spiritual preparation',
    text: 'Prepare your team before the trip with resources and guidance that help you serve with purpose and unity.',
  },
];
---

<section class="relative z-10 py-15 md:py-30 lg:py-37.5" aria-labelledby="sports-details-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[1600, 2400]} class="size-full object-cover" />
    <div class="absolute inset-0 bg-black/10"></div>
  </div>

  <div class="container">
    <div class="relative z-10 flex w-full flex-col justify-between gap-10 xl:flex-row xl:items-start">
      <div class="flex max-w-198 flex-col gap-7.5 text-cream">
        <div class="flex flex-col gap-3.75">
          <p class="leading-none font-bold uppercase opacity-80">We handle the details</p>
          <h2 id="sports-details-heading" class="max-w-155 text-3xl font-bold text-shadow-2xs md:text-5xl">Focus on Your Team. We’ll Handle the Rest.</h2>
        </div>
        <p class="max-w-146 text-lg leading-none font-medium">
          Planning an international mission trip takes time, experience, and trusted connections. Crew419 manages the logistics, partnerships, and preparation so your team can focus on what matters
          most — serving others, growing together, and sharing the Gospel through sports.
        </p>
      </div>

      <div class="flex w-full max-w-130 shrink-0 flex-col gap-5">
        {
          features.map((item) => (
            <article class="flex flex-col gap-5 rounded-lg bg-cream p-7.5">
              <div class="flex flex-col gap-3.75">
                <p class="text-primary text-2xl font-bold">{item.num}</p>
                <h3 class="text-2xl font-bold">{item.title}</h3>
              </div>
              <p class="leading-none">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute top-5 left-0 z-10 w-full -translate-y-1/2">
    <Image src={decorTop} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
  <div class="pointer-events-none absolute bottom-5 left-0 z-10 w-full translate-y-[70%]">
    <Image src={decorBottom} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
</section>
