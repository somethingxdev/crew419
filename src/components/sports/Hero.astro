---
import { Image } from 'astro:assets';
import decor from '@/assets/images/decor-bottom.png';
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

const {
  sports_hero_eyebrow: eyebrow,
  sports_hero_title: title,
  sports_hero_description: description,
  sports_hero_image: image,
} = await getSingleton('website_content');
const { default_primary_cta_label: ctaLabel, default_primary_cta_href: ctaHref } = await getSingleton('global');
---

<section class="relative" aria-labelledby="sports-hero-heading">
  <div class="absolute inset-0 overflow-hidden">
    <CmsImage image={image} alt="" widths={[800, 1600]} loading="eager" class="size-full object-cover object-bottom" />
    <div class="absolute inset-0 bg-black/10"></div>
  </div>

  <div class="relative container flex w-full flex-1 flex-col justify-between gap-20 py-60">
    <div class="flex w-full max-w-213 flex-col items-center text-center xl:items-start xl:text-left">
      <p class="leading-none font-bold text-cream/80 uppercase">{eyebrow}</p>
      <h1 id="sports-hero-heading" class="mt-3 text-4xl font-bold text-cream text-shadow-2xs md:text-6xl xl:text-[74px]">
        {title}
      </h1>
      <p class="mt-7.5 max-w-137.5 text-lg leading-none font-medium text-cream">
        {description}
      </p>
      <div class="mt-7.5 flex w-full max-w-137.5 flex-col gap-4 sm:flex-row">
        <Button href={ctaHref} variant="cream" size="lg" class="flex-1">{ctaLabel}</Button>
        <Button href="#how-it-works" variant="glass" size="lg" class="flex-1">See how it works</Button>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute -bottom-5 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto w-full" />
  </div>
</section>
