---
import { getSingleton } from '@/lib/content';

const {
  about_identity_eyebrow: eyebrow,
  about_identity_heading: heading,
  about_identity_text: text,
  about_identity_verse: verse,
  about_identity_marquee: marqueeText,
} = await getSingleton('website_content');

// Rich text paragraphs; the verse quote sits right after the second paragraph ("…where Jesus says:").
const [intro, lead, ...rest] = text.split(/(?<=<\/p>)/).filter((paragraph) => paragraph.trim());
---

<section class="overflow-x-clip py-15" aria-labelledby="our-identity-heading">
  <div class="container">
    <div class="flex flex-col gap-3.75">
      <p class="text-muted-foreground text-base leading-none font-bold uppercase">{eyebrow}</p>

      <div class="flex flex-col gap-10 xl:flex-row xl:items-start xl:justify-between xl:gap-30">
        <h2 id="our-identity-heading" class="max-w-130.25 text-3xl  font-bold md:text-5xl">{heading}</h2>

        <div class="flex w-full max-w-148.75 flex-col gap-10 text-base leading-none text-foreground [&_strong]:font-normal [&_strong]:text-primary">
          <Fragment set:html={intro} />

          <div class="flex flex-col gap-3.75">
            <Fragment set:html={lead} />
            <p class="font-serif text-2xl  font-bold">{verse}</p>
          </div>

          <Fragment set:html={rest.join('')} />
        </div>
      </div>
    </div>
  </div>

  <div class="mt-15 overflow-hidden md:mt-30" data-identity-marquee>
    <div class="flex w-max gap-x-15" data-identity-marquee-track>
      <p class="font-serif text-4xl  font-bold whitespace-nowrap text-foreground md:text-6xl xl:text-7xl">{marqueeText}</p>
      <p class="font-serif text-4xl  font-bold whitespace-nowrap text-foreground md:text-6xl xl:text-7xl" aria-hidden="true">{marqueeText}</p>
    </div>
  </div>
</section>

<style>
  @keyframes about-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 1.875rem));
    }
  }

  [data-identity-marquee-track] {
    animation: about-marquee 28s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-identity-marquee-track] {
      animation: none;
    }
  }
</style>
