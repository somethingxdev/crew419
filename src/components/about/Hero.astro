---
import { Image } from 'astro:assets';
import decor from '@/assets/images/decor-bottom.png';
import bg from '@/assets/images/about/hero-bg.png';
import { Button } from '@/shared/ui/button';
---

<section class="relative flex min-h-150 flex-col pt-20 xl:min-h-222 xl:pt-26" aria-labelledby="about-hero-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[800, 1600, 2400]} loading="eager" class="size-full object-cover object-center" />
    <div class="absolute inset-0 bg-[#cecece]/10"></div>
  </div>

  <div class="relative container w-full py-15 xl:pt-40 xl:pb-20">
    <div class="flex w-full max-w-242.5 flex-col items-center text-center xl:items-start xl:text-left">
      <p class="text-base leading-none font-bold text-foreground/80 uppercase">Our story</p>
      <h1 id="about-hero-heading" class="mt-3 text-4xl leading-[1.1] font-bold text-foreground text-shadow-2xs md:text-6xl xl:text-7xl">More Than a Mission Organization</h1>

      <p class="mt-7.5 max-w-137.5 text-lg leading-none font-medium text-foreground">
        Crew419 exists to equip and mobilize believers for short-term mission trips that strengthen local churches, transform lives, and share the Gospel around the world. We’re here to help
        you step into God’s mission – one journey at a time.
      </p>

      <div class="mt-7.5 flex w-full max-w-138 flex-col gap-4 sm:flex-row">
        <Button href="/contact" size="lg" class="flex-1">Book a 30–minute call</Button>
        <Button href="/trips" variant="soft" size="lg" class="flex-1">Explore Mission Trips</Button>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute -bottom-5 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto w-full bg-top" />
  </div>
</section>
