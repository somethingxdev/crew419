---
import { Image } from 'astro:assets';
import decor from '@/assets/images/decor-bottom.png';
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

const {
  about_hero_eyebrow: eyebrow,
  about_hero_title: title,
  about_hero_description: description,
  about_hero_image: image,
} = await getSingleton('website_content');
const { default_primary_cta_label: ctaLabel, default_primary_cta_href: ctaHref } = await getSingleton('global');
---

<section class="relative flex min-h-150 flex-col pt-20 xl:min-h-222 xl:pt-26" aria-labelledby="about-hero-heading">
  <div class="absolute inset-0 overflow-hidden">
    <CmsImage image={image} alt="" widths={[800, 1600, 2400]} loading="eager" class="size-full object-cover object-center" />
    <div class="absolute inset-0 bg-[#cecece]/10"></div>
  </div>

  <div class="relative container w-full py-15 xl:pt-40 xl:pb-20">
    <div class="flex w-full max-w-242.5 flex-col items-center text-center xl:items-start xl:text-left">
      <p class="text-base leading-none font-bold text-foreground/80 uppercase">{eyebrow}</p>
      <h1 id="about-hero-heading" class="mt-3 text-4xl  font-bold text-foreground text-shadow-2xs md:text-6xl xl:text-7xl">{title}</h1>

      <p class="mt-7.5 max-w-137.5 text-lg leading-none font-medium text-foreground">{description}</p>

      <div class="mt-7.5 flex w-full max-w-138 flex-col gap-4 sm:flex-row">
        <Button href={ctaHref} size="lg" class="flex-1">{ctaLabel}</Button>
        <Button href="/trips" variant="soft" size="lg" class="flex-1">Explore Mission Trips</Button>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute -bottom-5 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto w-full bg-top" />
  </div>
</section>
