---
import { getSingleton } from '@/lib/content';

const { about_values_eyebrow: eyebrow, about_values_heading: heading, about_values_cards: values } = await getSingleton('website_content');
---

<section class="py-15" aria-labelledby="what-we-believe-heading">
  <div class="container">
    <div class="mx-auto flex max-w-169 flex-col items-center gap-3.75 text-center">
      <p class="text-muted-foreground text-base leading-none font-bold uppercase">{eyebrow}</p>
      <h2 id="what-we-believe-heading" class="text-3xl  font-bold md:text-5xl">{heading}</h2>
    </div>

    <div class="mt-12.5 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {
        values.map((value) => (
          <article class="bg-cream flex flex-col justify-between gap-7.5 rounded-lg p-7.5 xl:h-44.5">
            <h3 class="text-muted-foreground text-2xl  font-bold">{value.title}</h3>
            <p class="text-lg leading-none font-medium">{value.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
