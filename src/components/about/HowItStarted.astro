---
import { Image } from 'astro:assets';
import photo1 from '@/assets/images/about/how-it-started/photo-1.png';
import photo2 from '@/assets/images/about/how-it-started/photo-2.png';
import PhotoPairSection from '@/components/shared/PhotoPairSection.astro';
---

<PhotoPairSection labelledBy="how-it-started-heading" class="py-30">
  <Image slot="image-left" src={photo1} alt="An early Crew419 mission team standing together with local children" width={600} height={600} />
  <Image slot="image-right" src={photo2} alt="Kevin Grubinski with fellow missionaries in the Dominican Republic" width={600} height={600} />

  <div class="flex w-full flex-col items-start gap-4">
    <p class="text-muted-foreground leading-none font-bold uppercase">How it started</p>
    <h2 id="how-it-started-heading" class="text-3xl font-bold md:text-5xl">The Beginning of Crew419</h2>
  </div>

  <div class="flex w-full max-w-137.5 flex-col items-start gap-7.5 text-foreground">
    <p class="leading-none">
      Crew419 was founded with one simple conviction: every believer is called to live on mission. After years of serving internationally and leading mission teams, Kevin Grubinski saw the need
      for an organization that would do more than organize trips. He wanted to prepare people spiritually, connect them with trusted local ministries, and help them continue living on mission long
      after returning home.
    </p>
    <p class="text-lg leading-none font-medium">
      Today, Crew419 partners with churches, schools, and ministry leaders to create meaningful short-term mission experiences that are centered on discipleship, service, and lasting Kingdom
      impact.
    </p>
  </div>
</PhotoPairSection>
