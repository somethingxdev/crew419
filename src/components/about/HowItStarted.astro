---
import CmsImage from '@/components/base/CmsImage.astro';
import PhotoPairSection from '@/components/shared/PhotoPairSection.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import { getSingleton } from '@/lib/content';

const {
  about_started_eyebrow: eyebrow,
  about_started_heading: heading,
  about_started_text: text,
  about_started_photo_left: photoLeft,
  about_started_photo_right: photoRight,
} = await getSingleton('website_content');
---

<PhotoPairSection labelledBy="how-it-started-heading" class="py-15 md:py-30">
  <CmsImage slot="image-left" image={photoLeft} alt="An early Crew419 mission team standing together with local children" widths={[600, 1200]} />
  <CmsImage slot="image-right" image={photoRight} alt="Kevin Grubinski with fellow missionaries in the Dominican Republic" widths={[600, 1200]} />

  <SectionHeading id="how-it-started-heading" {eyebrow} {heading} align="start" class="w-full" />

  <div class="flex w-full max-w-137.5 flex-col items-start gap-7.5 leading-none text-foreground [&>p:not(:first-child)]:text-lg [&>p:not(:first-child)]:font-medium" set:html={text} />
</PhotoPairSection>
