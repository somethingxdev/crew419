---
import { getCollection } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';

const { about_partners_eyebrow: eyebrow, about_partners_heading: heading, about_partners_text: text } = await getSingleton('website_content');

const partners = (await getCollection('partners', ({ data }) => data.show_on_about)).map(({ data }) => data).sort((a, b) => a.sort - b.sort);
---

<section class="overflow-x-clip py-15" aria-labelledby="partners-heading">
  <div class="container">
    <div class="mx-auto flex max-w-228.5 flex-col items-center gap-7.5 text-center">
      <div class="flex w-full flex-col items-center gap-3.75">
        <p class="text-muted-foreground text-base leading-none font-bold uppercase">{eyebrow}</p>
        <h2 id="partners-heading" class="text-3xl  font-bold md:text-5xl">{heading}</h2>
      </div>
      <p class="max-w-120.5 text-base leading-none">{text}</p>
    </div>
  </div>

  <div class="mt-12.5 overflow-hidden" data-partners-marquee>
    <ul class="flex w-max gap-5" data-partners-track>
      {
        [...partners, ...partners].map((partner, index) => {
          const Wrapper = partner.url ? 'a' : 'div';
          return (
            <li class="bg-cream flex h-40 w-75 shrink-0 items-center justify-center rounded-lg" aria-hidden={index >= partners.length ? 'true' : undefined}>
              <Wrapper
                href={partner.url}
                target={partner.url ? '_blank' : undefined}
                rel={partner.url ? 'noopener' : undefined}
                class="flex size-full items-center justify-center p-6"
              >
                {partner.logo ? (
                  <CmsImage image={partner.logo} alt={partner.name} widths={[300, 600]} class="max-h-full max-w-full object-contain" />
                ) : (
                  <span class="text-muted-foreground text-base leading-none font-bold uppercase">{partner.name}</span>
                )}
              </Wrapper>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  @keyframes about-partners-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 0.625rem));
    }
  }

  [data-partners-track] {
    animation: about-partners-marquee 30s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-partners-track] {
      animation: none;
    }
  }
</style>
