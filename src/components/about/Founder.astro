---
import VideoPoster from '@/components/shared/VideoPoster.astro';
import { getSingleton } from '@/lib/content';

const {
  about_founder_heading: heading,
  about_founder_name: name,
  about_founder_role: role,
  about_founder_photo: photo,
  about_founder_video: video,
  about_founder_bio_before: bioBefore,
  about_founder_bio_after: bioAfter,
} = await getSingleton('website_content');
---

<section class="py-15" aria-labelledby="founder-heading">
  <div class="container">
    <div class="mx-auto flex max-w-146.75 flex-col items-center gap-10 text-center">
      <h2 id="founder-heading" class="text-3xl leading-[1.1] font-bold md:text-5xl">{heading}</h2>

      <div class="flex w-full max-w-110.75 flex-col items-center gap-7.5">
        <p class="text-base leading-none">{bioBefore}</p>

        <figure class="bg-cream flex w-99.75 max-w-full flex-col gap-3 rounded-sm p-3 shadow-polaroid">
          <VideoPoster {video} poster={photo} alt={`${name}, ${role}`} widths={[400, 800]} class="aspect-375/292 w-full" rounded="rounded-sm" playLabel={`Play the video about ${name}`} />

          <figcaption class="flex flex-col gap-2.5 text-left">
            <p class="text-lg leading-none font-medium">{name}</p>
            <p class="text-muted-foreground text-base leading-none">{role}</p>
          </figcaption>
        </figure>

        <p class="text-base leading-none">{bioAfter}</p>
      </div>
    </div>
  </div>
</section>
