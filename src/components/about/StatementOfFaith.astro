---
import creation from '@/assets/images/about/beliefs/creation.png';
import scripture from '@/assets/images/about/beliefs/scripture.png';
import trinity from '@/assets/images/about/beliefs/trinity.png';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';
import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle, DialogTrigger } from '@/shared/ui/dialog';

const {
  about_faith_eyebrow: eyebrow,
  about_faith_heading: heading,
  about_faith_intro: intro,
  about_faith_statements: statements,
} = await getSingleton('website_content');

// Statements with a short `card_text` are highlighted as cards; decorative icons cycle in order.
const icons = [trinity, scripture, creation];
const beliefs = statements
  .filter((statement) => statement.card_text)
  .map((statement, index) => ({ ...statement, icon: icons[index % icons.length] }));
---

<section class="py-15" aria-labelledby="statement-of-faith-heading">
  <div class="container">
    <div class="mx-auto flex max-w-217.75 flex-col items-center gap-7.5 text-center">
      <div class="flex w-full flex-col items-center gap-3.75">
        <p class="text-muted-foreground text-base leading-none font-bold uppercase">{eyebrow}</p>
        <h2 id="statement-of-faith-heading" class="text-3xl font-bold md:text-5xl">{heading}</h2>
      </div>
      <p class="max-w-107.25 text-base leading-none">{intro}</p>
      <Dialog id="statement-of-faith-dialog">
        <DialogTrigger asChild class="w-82.5 max-w-full">
          <Button size="lg" class="w-full">Read Full Statement of Faith</Button>
        </DialogTrigger>
        <DialogContent class="sm:max-w-[865px] p-12.5">
          <div class="flex flex-col gap-12.5">
            <DialogHeader class="text-center sm:text-center">
              <DialogTitle class="text-3xl font-bold tracking-normal sm:text-5xl">{heading}</DialogTitle>
              <DialogDescription class="sr-only">Crew419’s complete statement of faith.</DialogDescription>
            </DialogHeader>
            <div class="flex flex-col gap-7.5 text-center">
              {
                statements.map((statement) => (
                  <article class="flex flex-col gap-5 border-b border-muted-foreground/50 pb-7.5 last:border-b-0 last:pb-0">
                    <h3 class="text-2xl  font-bold">{statement.title}</h3>
                    <p class="max-w-md mx-auto text-center leading-none">{statement.text}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </DialogContent>
      </Dialog>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {
        beliefs.map((belief) => (
          <article class="bg-cream flex flex-col gap-7.5 rounded-lg p-7.5">
            <span class="bg-muted-foreground block size-10 shrink-0" style={`mask: url(${belief.icon.src}) center / contain no-repeat`} aria-hidden="true" />
            <h3 class="text-2xl  font-bold">{belief.title}</h3>
            <p class="text-muted-foreground text-base leading-none">{belief.card_text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
