---
import { Image } from 'astro:assets';
import bg from '@/assets/images/about/cta-bg.png';
import { Button } from '@/shared/ui/button';
---

<section class="py-15" aria-labelledby="about-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <Image src={bg} alt="" widths={[1600]} class="size-full object-cover object-center" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-154.5 flex-col items-center justify-center gap-7.5 px-5 py-15 text-center text-cream md:py-0">
        <div class="flex w-full flex-col items-center gap-6.25">
          <h2 id="about-cta-heading" class="text-3xl  font-bold md:text-5xl">Ready to Be Part of Something Bigger?</h2>
          <p class="max-w-118.5 text-base leading-none">
            Whether you’re joining your first mission trip or leading an entire team, we’re here to help you take the next step in God’s mission.
          </p>
        </div>

        <Button href="/contact" variant="cream" size="lg" class="w-82.5 max-w-full">Book a 30–minute call</Button>
      </div>
    </div>
  </div>
</section>
