---
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

const {
  about_cta_title: title,
  about_cta_text: text,
  about_cta_image: image,
  about_cta_primary_label: primaryLabel,
  about_cta_primary_href: primaryHref,
  about_cta_secondary_label: secondaryLabel,
  about_cta_secondary_href: secondaryHref,
} = await getSingleton('website_content');
---

<section class="py-15" aria-labelledby="about-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <CmsImage image={image} alt="" widths={[1600]} class="size-full object-cover object-center" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-154.5 flex-col items-center justify-center gap-7.5 px-5 py-15 text-center text-cream md:py-0">
        <div class="flex w-full flex-col items-center gap-6.25">
          <h2 id="about-cta-heading" class="text-3xl  font-bold md:text-5xl">{title}</h2>
          <p class="max-w-118.5 text-base leading-none">{text}</p>
        </div>

        <div class="flex w-full flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <Button href={primaryHref} variant="cream" size="lg" class="w-82.5 max-w-full">{primaryLabel}</Button>
          {
            secondaryLabel && secondaryHref && (
              <Button href={secondaryHref} variant="glass" size="lg" class="w-82.5 max-w-full">
                {secondaryLabel}
              </Button>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
