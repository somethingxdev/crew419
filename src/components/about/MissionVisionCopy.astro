---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  kind: 'mission' | 'vision' | 'motto';
}

const { eyebrow, title, text, kind } = Astro.props;

// Multiline text → paragraphs. For the motto, a trailing "Verse · Verse · …" line becomes the verse list.
const paragraphs = text
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const last = paragraphs.at(-1);
const verses = kind === 'motto' && last?.includes('·') ? last.split(/\s*·\s*/) : [];
const body = verses.length ? paragraphs.slice(0, -1) : paragraphs;
---

<div class="flex w-full flex-col items-center gap-7.5 py-15 text-center xl:py-0">
  <div class="flex w-full flex-col items-center gap-3.75">
    <p class="text-muted-foreground text-base leading-none font-bold uppercase">{eyebrow}</p>
    <h2 class="text-3xl  font-bold md:text-5xl">{title}</h2>
  </div>

  {kind === 'mission' && body.map((paragraph) => <p class="max-w-126.25 text-base leading-none">{paragraph}</p>)}

  {kind === 'vision' && body.map((paragraph) => <p class="max-w-135.5 text-base leading-none">{paragraph}</p>)}

  {
    kind === 'motto' && (
      <>
        <div class="flex max-w-152.5 flex-col gap-2.5 text-base leading-none">
          {body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        {verses.length > 0 && (
          <ul class="flex flex-wrap items-center justify-center gap-3.75 text-lg leading-none font-medium">
            {verses.map((verse, verseIndex) => (
              <li class="flex items-center gap-3.75">
                {verseIndex > 0 && <span class="bg-foreground size-1.5 rounded-full" aria-hidden="true" />}
                {verse}
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }
</div>
