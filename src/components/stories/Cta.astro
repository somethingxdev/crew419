---
import { Image } from 'astro:assets';
import bg from '@/assets/images/stories/cta-bg.png';
import { Button } from '@/shared/ui/button';
---

<section class="py-15" aria-labelledby="stories-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <Image src={bg} alt="" widths={[1600]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-145 flex-col items-center justify-center gap-7.5 px-5 py-15 text-center text-cream md:py-0">
        <div class="flex w-full flex-col items-center gap-6">
          <h2 id="stories-cta-heading" class="text-3xl  font-bold md:text-5xl">Where Will God Send You Next?</h2>
          <p class="text-base leading-none">The next story we share could be yours. Join an upcoming mission trip and become part of what God is doing around the world.</p>
        </div>
        <div class="flex w-full flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <Button href="/contact" variant="cream" size="lg" class="w-full sm:w-auto">Book a 30–minute call</Button>
          <Button href="/trips" variant="glass" size="lg" class="w-full sm:w-62">Find your trip</Button>
        </div>
      </div>
    </div>
  </div>
</section>
