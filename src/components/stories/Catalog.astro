---
import { Image, type LocalImageProps } from 'astro:assets';
import ChevronDown from '@tabler/icons/outline/chevron-down.svg';
import dominicanPartnership from '@/assets/images/stories/cards/dominican-partnership.png';
import guatemalaHeart from '@/assets/images/stories/cards/guatemala-heart.png';
import guatemalaHomes from '@/assets/images/stories/cards/guatemala-homes.png';
import kenyaOutreach from '@/assets/images/stories/cards/kenya-outreach.png';
import localChurches from '@/assets/images/stories/cards/local-churches.png';
import oneWeek from '@/assets/images/stories/cards/one-week.png';
import summerSeason from '@/assets/images/stories/cards/summer-season.png';
import youthGroup from '@/assets/images/stories/cards/youth-group.png';
import { Dropdown, DropdownContent, DropdownRadioGroup, DropdownRadioItem, DropdownTrigger } from '@/shared/ui/dropdown';

type FilterOption = { label: string; value: string };

interface Filter {
  key: 'type' | 'region' | 'ministry';
  label: string;
  options: FilterOption[];
}

const filters: Filter[] = [
  {
    key: 'type',
    label: 'Story Type',
    options: [
      { label: 'All Types', value: 'all' },
      { label: 'Trip Recap', value: 'trip-recap' },
      { label: 'Testimony', value: 'testimony' },
      { label: 'Ministry Update', value: 'ministry-update' },
    ],
  },
  {
    key: 'region',
    label: 'Region',
    options: [
      { label: 'All Regions', value: 'all' },
      { label: 'USA', value: 'usa' },
      { label: 'Canada', value: 'canada' },
      { label: 'Caribbean', value: 'caribbean' },
      { label: 'Central America', value: 'central-america' },
      { label: 'South America', value: 'south-america' },
      { label: 'Africa', value: 'africa' },
      { label: 'Europe', value: 'europe' },
      { label: 'Middle East', value: 'middle-east' },
      { label: 'Asia', value: 'asia' },
    ],
  },
  {
    key: 'ministry',
    label: 'Ministry',
    options: [
      { label: 'All Ministries', value: 'all' },
      { label: 'Children', value: 'children' },
      { label: 'Construction', value: 'construction' },
      { label: 'Evangelism', value: 'evangelism' },
      { label: 'Medical', value: 'medical' },
      { label: 'Sports', value: 'sports' },
    ],
  },
];

interface Story {
  slug: string;
  type: string;
  region: string;
  ministry: string;
  title: string;
  date: string;
  image: LocalImageProps['src'];
  alt: string;
}

const typeLabels: Record<string, string> = Object.fromEntries(filters[0].options.map((option) => [option.value, option.label]));

const stories: Story[] = [
  {
    slug: 'kenya-community-outreach',
    type: 'trip-recap',
    region: 'africa',
    ministry: 'children',
    title: 'Kenya Community Outreach',
    date: 'January 2025',
    image: kenyaOutreach,
    alt: 'Volunteers and children raising their hands together in a village',
  },
  {
    slug: 'god-changed-my-heart-in-guatemala',
    type: 'testimony',
    region: 'central-america',
    ministry: 'evangelism',
    title: '“God Changed My Heart in Guatemala”',
    date: 'January 2025',
    image: guatemalaHeart,
    alt: 'A volunteer in a khaki shirt seen from behind, greeting a local family',
  },
  {
    slug: 'new-church-partnership-in-the-dominican-republic',
    type: 'ministry-update',
    region: 'caribbean',
    ministry: 'evangelism',
    title: 'New Church Partnership in the Dominican Republic',
    date: 'January 2025',
    image: dominicanPartnership,
    alt: 'Three men smiling together in front of a church building',
  },
  {
    slug: 'building-homes-in-guatemala',
    type: 'trip-recap',
    region: 'central-america',
    ministry: 'construction',
    title: 'Building Homes in Guatemala',
    date: 'January 2025',
    image: guatemalaHomes,
    alt: 'A volunteer laying bricks with a volcano in the background',
  },
  {
    slug: 'our-youth-group-came-home-different',
    type: 'testimony',
    region: 'usa',
    ministry: 'sports',
    title: '“Our Youth Group Came Home Different”',
    date: 'January 2025',
    image: youthGroup,
    alt: 'A youth group posing together in front of a colorful house',
  },
  {
    slug: 'preparing-for-summer-mission-season',
    type: 'ministry-update',
    region: 'africa',
    ministry: 'medical',
    title: 'Preparing for Summer Mission Season',
    date: 'January 2025',
    image: summerSeason,
    alt: 'A woman reading a book on a hillside overlooking a mountain lake',
  },
  {
    slug: 'one-week-that-changed-my-life',
    type: 'testimony',
    region: 'africa',
    ministry: 'children',
    title: '“One Week That Changed My Life”',
    date: 'January 2025',
    image: oneWeek,
    alt: 'A volunteer standing in front of a village home',
  },
  {
    slug: 'serving-alongside-local-churches',
    type: 'trip-recap',
    region: 'south-america',
    ministry: 'construction',
    title: 'Serving alongside local churches',
    date: 'January 2025',
    image: localChurches,
    alt: 'A mission team gathered outside a local church',
  },
];

const pages = [1, 2, 3];
const currentPage = 1;
---

<section class="pt-20 pb-15 md:pb-30 xl:pt-30" aria-labelledby="stories-catalog-heading" data-stories-catalog>
  <div class="container">
    <h2 id="stories-catalog-heading" class="sr-only">All stories</h2>

    <div class="flex flex-wrap items-center gap-x-10 gap-y-4" role="group" aria-label="Filter stories">
      {
        filters.map((filter) => (
          <Dropdown>
            <DropdownTrigger class="gap-2.5 text-lg leading-none font-medium text-foreground transition-colors hover:text-primary data-[state=open]:text-primary [&>svg]:size-4 [&>svg]:shrink-0 [&>svg]:transition-transform data-[state=open]:[&>svg]:rotate-180">
              <span data-filter-label={filter.key}>{filter.label}</span>
              <ChevronDown aria-hidden="true" />
            </DropdownTrigger>
            <DropdownContent align="start" sideOffset={12} class="bg-cream text-foreground min-w-50 rounded-lg border-0 p-2 shadow-[0_4px_15px_rgba(0,0,0,0.2)]">
              <DropdownRadioGroup defaultValue="all" data-filter={filter.key} data-filter-default-label={filter.label}>
                {filter.options.map((option) => (
                  <DropdownRadioItem value={option.value} closeOnClick class="cursor-pointer py-2 pr-9 pl-3 text-base leading-none font-medium hover:bg-primary/20 focus:bg-primary/20 data-highlighted:bg-primary/20 data-checked:text-primary" indicatorClass="right-3">
                    {option.label}
                  </DropdownRadioItem>
                ))}
              </DropdownRadioGroup>
            </DropdownContent>
          </Dropdown>
        ))
      }
    </div>

    <ul class="mt-7.5 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4" data-stories-grid>
      {
        stories.map((story) => (
          <li data-story data-type={story.type} data-region={story.region} data-ministry={story.ministry}>
            <article class="bg-cream flex h-full flex-col rounded-lg px-4 pt-4 pb-5">
              <a href={`/stories/${story.slug}`} class="block overflow-hidden rounded-lg" tabindex="-1" aria-hidden="true">
                <Image src={story.image} alt={story.alt} widths={[400, 800]} class="h-65 w-full object-cover transition-transform duration-500 hover:scale-105" />
              </a>
              <div class="mt-5 flex flex-1 flex-col">
                <p class="text-muted-foreground text-base leading-none font-bold uppercase">{typeLabels[story.type]}</p>
                <h3 class="mt-2.5 line-clamp-2 min-h-13 text-2xl leading-[1.1] font-bold">
                  <a href={`/stories/${story.slug}`} class="hover:text-primary transition-colors">
                    {story.title}
                  </a>
                </h3>
                <p class="text-muted-foreground mt-5 text-base leading-none">{story.date}</p>
              </div>
              <a
                href={`/stories/${story.slug}`}
                class="text-muted-foreground border-muted-foreground hover:text-foreground hover:border-foreground mt-5 self-start border-b pb-2 text-base leading-none font-black uppercase transition-colors"
              >
                Read Story<span class="sr-only">: {story.title}</span>
              </a>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="text-muted-foreground mt-10 hidden text-center text-lg leading-none font-medium" data-stories-empty>No stories match the selected filters yet.</p>

    <nav class="mt-12.5 flex items-center justify-between gap-5" aria-label="Pagination" data-stories-pagination>
      <span class="text-muted-foreground text-base leading-none font-black uppercase" aria-disabled="true">Previous</span>
      <ul class="flex items-center gap-5">
        {
          pages.map((page) => (
            <li>
              {page === currentPage ? (
                <span class="bg-secondary text-secondary-foreground flex size-12.5 items-center justify-center rounded-full pt-1 text-base leading-none font-black" aria-current="page">
                  {page}
                </span>
              ) : (
                <a href={`/stories?page=${page}`} class="hover:text-primary flex size-12.5 items-center justify-center rounded-full pt-1 text-base leading-none font-black transition-colors">
                  {page}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <a href="/stories?page=2" class="hover:text-primary text-base leading-none font-black uppercase transition-colors">Next</a>
    </nav>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-stories-catalog]');

  if (section) {
    const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-story]'));
    const empty = section.querySelector<HTMLElement>('[data-stories-empty]');
    const pagination = section.querySelector<HTMLElement>('[data-stories-pagination]');
    const selected: Record<string, string> = { type: 'all', region: 'all', ministry: 'all' };

    const applyFilters = () => {
      let visible = 0;

      cards.forEach((card) => {
        const match = Object.entries(selected).every(([key, value]) => value === 'all' || card.dataset[key] === value);
        card.hidden = !match;
        if (match) visible += 1;
      });

      const filtered = Object.values(selected).some((value) => value !== 'all');
      empty?.classList.toggle('hidden', visible > 0);
      pagination?.classList.toggle('hidden', filtered);
    };

    // Dropdown content is portaled outside the section, so listen on the document.
    document.addEventListener('starwind:value-change', (event) => {
      const group = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-filter]');
      if (!group) return;

      const key = group.dataset.filter!;
      const value = String((event as CustomEvent<{ value?: string | null }>).detail?.value ?? 'all');
      selected[key] = value;

      const item = group.querySelector<HTMLElement>(`[data-sw-menu-radio-item][data-value="${value}"]`);
      const label = section.querySelector<HTMLElement>(`[data-filter-label="${key}"]`);
      if (label) label.textContent = value === 'all' ? group.dataset.filterDefaultLabel! : (item?.textContent?.trim() ?? group.dataset.filterDefaultLabel!);

      applyFilters();
    });
  }
</script>
