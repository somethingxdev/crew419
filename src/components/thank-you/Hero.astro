---
import { Button } from '@/shared/ui/button';
---

<section class="relative pt-32 pb-24 md:pt-40 xl:pt-52 xl:pb-30" aria-labelledby="thank-you-heading">
  <div class="container">
    <div class="mx-auto flex w-full max-w-242.5 flex-col items-center gap-8 text-center">
      <h1 id="thank-you-heading" class="text-4xl leading-[1.1] font-bold text-foreground md:text-6xl xl:text-7xl">Thank You for Supporting the Mission</h1>

      <div class="flex w-full max-w-138 flex-col items-center gap-8">
        <p class="max-w-132 text-lg leading-none font-medium text-foreground/80">
          Because of your generosity, more believers will be equipped to serve, more churches will be strengthened, and more communities will hear the Gospel.
        </p>

        <div class="flex w-full flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href="/trips" variant="primary" size="lg" class="w-full sm:w-67">Explore Mission Trips</Button>
          <Button href="/stories" variant="soft" size="lg" class="w-full sm:w-67">Read stories</Button>
        </div>
      </div>
    </div>
  </div>
</section>
