---
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

const {
  thank_you_title: title,
  thank_you_text: text,
  thank_you_primary_label: primaryLabel,
  thank_you_primary_href: primaryHref,
  thank_you_secondary_label: secondaryLabel,
  thank_you_secondary_href: secondaryHref,
} = await getSingleton('website_content');
---

<section class="relative pt-32 pb-24 md:pt-40 xl:pt-52 xl:pb-30" aria-labelledby="thank-you-heading">
  <div class="container">
    <div class="mx-auto flex w-full max-w-242.5 flex-col items-center gap-8 text-center">
      <h1 id="thank-you-heading" class="text-4xl  font-bold text-foreground md:text-6xl xl:text-7xl">{title}</h1>

      <div class="flex w-full max-w-138 flex-col items-center gap-8">
        <p class="max-w-132 text-lg leading-none font-medium text-foreground/80">{text}</p>

        <div class="flex w-full flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href={primaryHref} variant="primary" size="lg" class="w-full sm:w-67">{primaryLabel}</Button>
          <Button href={secondaryHref} variant="soft" size="lg" class="w-full sm:w-67">{secondaryLabel}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
