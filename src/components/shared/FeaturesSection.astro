---
/**
 * Full-bleed photo section with an eyebrow/heading (+ optional text) on the left and
 * numbered feature cards on the right. Below `md` the cards become a horizontal drag slider
 * pinned to the bottom of the section; from `md` they sit in a second column.
 *
 * Used on: trips hub, custom trips, churches, schools, sports, donate.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import DecorEdges from '@/components/shared/DecorEdges.astro';

interface Feature {
  num: string;
  title: string;
  text: string;
}

interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  /** Optional paragraph(s) under the heading; blank lines split paragraphs. */
  text?: string | null;
  features: Feature[];
  bg: ImageMetadata;
  /** Tailwind object-position for the background photo. */
  bgPosition?: 'center' | 'bottom';
  /** Overlay tint on top of the photo. */
  overlay?: string;
  /** Extra classes for the section (e.g. z-index overrides). */
  class?: string;
}

const { id, eyebrow, heading, text, features, bg, bgPosition = 'center', overlay = 'bg-black/10', class: className } = Astro.props;

const headingId = `${id}-heading`;
const paragraphs = text ? text.split(/\n\s*\n/) : [];
---

<section id={id} class:list={['relative z-10 py-15 md:py-30 lg:py-37.5', className]} aria-labelledby={headingId} data-features-section>
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[1600, 2400]} class:list={['size-full object-cover', bgPosition === 'bottom' ? 'object-bottom' : 'object-center']} />
    <div class:list={['absolute inset-0', overlay]}></div>
  </div>

  <div class="container">
    {/* Below md the cards sit at the bottom of the section as a drag slider, so the heading is pushed to the top. */}
    <div class="relative z-10 flex w-full flex-col justify-between gap-10 max-md:min-h-132.75 md:flex-row md:items-start md:gap-4 xl:gap-10">
      <div
        class:list={[
          'flex flex-col text-cream md:flex-1 md:items-start md:text-left xl:max-w-215',
          paragraphs.length ? 'gap-5 md:gap-7.5' : 'gap-2.5 md:gap-3.75',
          paragraphs.length ? 'items-start text-left' : 'items-center text-center',
        ]}
      >
        <div class="flex flex-col gap-2.5 md:gap-3.75">
          <p class="text-xs leading-none font-bold uppercase opacity-80 md:text-[15px] xl:text-base">{eyebrow}</p>
          <h2 id={headingId} class="text-3xl leading-[1.05] font-bold text-shadow-2xs md:text-4xl xl:text-5xl">{heading}</h2>
        </div>
        {
          paragraphs.length > 0 && (
            <div class="flex max-w-144 flex-col gap-2.5 text-sm leading-none font-medium md:text-base xl:text-lg">
              {paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          )
        }
      </div>

      <div class="w-full md:flex-1 xl:w-full xl:max-w-130 xl:flex-none" data-features-viewport>
        <div class="flex gap-3.5 max-md:pr-5 md:flex-col xl:gap-5">
          {
            features.map((item) => (
              <article class="flex w-70 shrink-0 flex-col justify-between gap-5 rounded-lg bg-cream p-3.75 md:w-full xl:p-7.5">
                <div class="flex flex-col gap-2.5 xl:gap-3.75">
                  <p class="text-primary text-lg font-bold xl:text-2xl">{item.num}</p>
                  <h3 class="text-lg leading-[1.1] font-bold xl:text-2xl">{item.title}</h3>
                </div>
                <p class="text-sm leading-none xl:text-base">{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <DecorEdges top="top-0 md:top-5" bottom="bottom-0 md:bottom-5 translate-y-[70%]" />
</section>

<script>
  import EmblaCarousel from 'embla-carousel';
  import type { EmblaCarouselType } from 'embla-carousel';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // From md the cards stack in a column, so the carousel only runs below it.
  const stacked = window.matchMedia('(min-width: 768px)');

  document.querySelectorAll<HTMLElement>('[data-features-viewport]').forEach((viewport) => {
    let embla: EmblaCarouselType | undefined;

    const sync = () => {
      if (stacked.matches) {
        embla?.destroy();
        embla = undefined;
        return;
      }

      embla ??= EmblaCarousel(viewport, {
        align: 'start',
        containScroll: 'trimSnaps',
        duration: reduced ? 0 : 25,
        watchDrag: !reduced,
      });
    };

    stacked.addEventListener('change', sync);
    sync();
  });
</script>
