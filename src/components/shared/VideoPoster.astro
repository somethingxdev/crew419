---
/**
 * Video with a poster and a glass play button; falls back to the poster image when there is no video.
 * The glass button is the poster's only control; the native ones appear once it plays.
 */
import PlayerPlay from '@tabler/icons/filled/player-play.svg';
import CmsImage from '@/components/base/CmsImage.astro';
import type { DirectusImage } from '@/lib/directus-loader';

interface Props {
  video?: { url: string } | null;
  poster: DirectusImage;
  alt: string;
  /** Aspect ratio + sizing classes for the media. */
  class: string;
  widths?: number[];
  playLabel?: string;
  rounded?: string;
}

const { video, poster, alt, class: className, widths = [800, 1600], playLabel = 'Play the video', rounded = 'rounded-lg' } = Astro.props;
---

<div class:list={['relative overflow-hidden', rounded]} data-video-poster>
  {
    video ? (
      <video src={video.url} poster={poster.url} preload="none" playsinline class:list={['bg-black object-cover', className]} aria-label={alt} data-video-poster-video />
    ) : (
      <CmsImage image={poster} {alt} {widths} class:list={['object-cover', className]} />
    )
  }

  {
    video && (
      <button
        type="button"
        class="absolute top-1/2 left-1/2 flex h-16.25 w-16.875 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-lg bg-white/15 shadow-[inset_0_0_2px_rgba(0,0,0,0.25)] backdrop-blur-[10px] transition-colors hover:bg-white/25"
        aria-label={playLabel}
        data-video-poster-play
      >
        <PlayerPlay class="size-5 text-white" aria-hidden="true" />
      </button>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-poster]').forEach((media) => {
    const video = media.querySelector<HTMLVideoElement>('[data-video-poster-video]');
    const play = media.querySelector<HTMLButtonElement>('[data-video-poster-play]');
    if (!video || !play) return;

    play.addEventListener('click', () => {
      video.controls = true;
      play.hidden = true;
      void video.play();
    });

    video.addEventListener('pause', () => {
      if (video.currentTime === 0) play.hidden = false;
    });
  });
</script>
