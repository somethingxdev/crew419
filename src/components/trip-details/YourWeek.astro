---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  trip: CollectionEntry<'trips'>;
}

const { itinerary: days, week_media: media } = Astro.props.trip.data;

// `week_media` is a generic file: a video, or an image (Directus knows the size of images).
const isVideo = media.type.startsWith('video/');
const mediaClass = 'h-auto w-full rounded-lg object-cover lg:h-134.5 lg:flex-1';
---

<section class="py-15" aria-labelledby="your-week-heading">
  <div class="container">
    <div class="flex flex-col items-center gap-4 text-center">
      <p class="text-muted-foreground leading-none font-bold uppercase">Your week</p>
      <h2 id="your-week-heading" class="max-w-164 text-3xl font-bold md:text-5xl">What Your Mission Week Could Look Like</h2>
    </div>

    <div class="mt-12.5 flex flex-col gap-12.5 lg:flex-row lg:items-start lg:gap-20">
      <ul class="flex w-full flex-col max-w-[485px]">
        {
          days.map((day) => (
            <li class="flex flex-col gap-4 py-12.5 first:pt-0 border-b border-muted-foreground">
              <h3 class="text-2xl font-bold">{day.title}</h3>
              <p class="text-lg leading-tight">{day.text}</p>
            </li>
          ))
        }
      </ul>

      {
        isVideo ? (
          <video src={media.url} class={mediaClass} autoplay muted loop playsinline />
        ) : media.width && media.height ? (
          <Image src={media.url} width={media.width} height={media.height} alt="" widths={[800, 1600]} class={mediaClass} />
        ) : (
          <Image src={media.url} inferSize alt="" widths={[800, 1600]} class={mediaClass} />
        )
      }
    </div>
  </div>
</section>
