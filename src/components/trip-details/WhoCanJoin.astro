---
import type { CollectionEntry } from 'astro:content';
import church from '@/assets/images/trip-details/icons/church.png';
import compass from '@/assets/images/trip-details/icons/compass.png';
import family from '@/assets/images/trip-details/icons/family.png';
import handshake from '@/assets/images/trip-details/icons/handshake.png';
import individual from '@/assets/images/trip-details/icons/individual.png';
import school from '@/assets/images/trip-details/icons/school.png';

interface Props {
  trip: CollectionEntry<'trips'>;
}

const { who_can_join: groups } = Astro.props.trip.data;

// No CMS field for the card icons — local icons, assigned by position.
const icons = [individual, church, school, family, compass, handshake];
---

<section class="py-15" aria-labelledby="who-can-join-heading">
  <div class="container">
    <div class="flex flex-col items-center gap-4 text-center">
      <p class="text-muted-foreground leading-none font-bold uppercase">Who can join</p>
      <h2 id="who-can-join-heading" class="text-3xl font-bold md:text-5xl">Everyone Has a Place to Serve</h2>
    </div>

    <div class="mt-12.5 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {
        groups.map((group, index) => {
          const icon = icons[index % icons.length];
          return (
            <article class="bg-cream flex h-50 flex-col justify-between rounded-lg p-7.5">
              <span
                class="bg-muted-foreground block size-10"
                style={`-webkit-mask:url("${icon.src}") center/contain no-repeat;mask:url("${icon.src}") center/contain no-repeat`}
                aria-hidden="true"
              />
              <h3 class="text-2xl font-bold">{group.title}</h3>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
