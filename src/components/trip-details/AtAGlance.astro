---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '@/components/shared/SectionHeading.astro';

interface Props {
  trip: CollectionEntry<'trips'>;
}

const { glance_facts: facts } = Astro.props.trip.data;
---

<section class="py-15 md:py-30" aria-labelledby="at-a-glance-heading">
  <div class="container">
    <SectionHeading id="at-a-glance-heading" eyebrow="At a glance" heading="Everything You Need to Know" class="mb-10" />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        facts.map((fact) => (
          <article class="bg-cream flex flex-col gap-5 md:gap-7.5 justify-between rounded-lg p-4 md:p-7.5">
            <h3 class="text-muted-foreground text-2xl  font-bold">{fact.title}</h3>
            <p class="leading-tight">{fact.value}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
