---
import type { CollectionEntry } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';
import PhotoPairSection from '@/components/shared/PhotoPairSection.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';

interface Props {
  category: CollectionEntry<'trip_categories'>;
}

// The About content is shared by every trip of the category, so it lives on the category.
const { about_text: text, about_photo_left: photoLeft, about_photo_right: photoRight } = Astro.props.category.data;
---

<PhotoPairSection labelledBy="about-mission-heading">
  <CmsImage slot="image-left" image={photoLeft} alt="" widths={[600, 1200]} />
  <CmsImage slot="image-right" image={photoRight} alt="" widths={[600, 1200]} />

  <SectionHeading id="about-mission-heading" eyebrow="About the mission" heading="Serve Local Communities with Purpose" align="start" class="w-full" />
  <div class="flex max-w-129.25 flex-col gap-4 leading-tight" set:html={text} />
</PhotoPairSection>
