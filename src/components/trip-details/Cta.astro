---
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';
import { SITE_LINKS } from '@/lib/links';
import { Button } from '@/shared/ui/button';

// The CTA is identical on every trip page, so it lives in `website_content` instead of on each trip.
const { trip_cta_title: title, trip_cta_text: text, trip_cta_image: bg } = await getSingleton('website_content');
---

<section class="py-15" aria-labelledby="trip-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <CmsImage image={bg} alt="" widths={[1600]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-155 flex-col items-center justify-center px-5 py-15 text-center text-cream md:py-0">
        <h2 id="trip-cta-heading" class="text-3xl  font-bold md:text-5xl">{title}</h2>
        <p class="mt-7.5 max-w-137.5 leading-tight">{text}</p>
        <div class="mt-7.5 flex w-full max-w-133 flex-col gap-4 sm:flex-row">
          <Button href={SITE_LINKS.call.href} variant="cream" size="lg" class="flex-1">{SITE_LINKS.call.label}</Button>
          <Button href={SITE_LINKS.destinations.href} variant="glass" size="lg" class="flex-1">{SITE_LINKS.destinations.label}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
