---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import decor from '@/assets/images/decor-bottom.png';
import CmsImage from '@/components/base/CmsImage.astro';
import { Button } from '@/shared/ui/button';
import { SITE_LINKS } from '@/lib/links';
import { tripFacts } from '@/lib/trip';

interface Props {
  trip: CollectionEntry<'trips'>;
  category: CollectionEntry<'trip_categories'>;
}

const trip = Astro.props.trip.data;
const { hero_title: title, hero_description: description, hero_image: bg } = trip;

// Dates, length, category and price all come from the Overview fields — nothing to fill in by hand.
const facts = tripFacts(trip, Astro.props.category.data.name);
---

<section class="relative flex min-h-150 flex-col pt-20 md:min-h-201.75 md:pt-30 xl:min-h-221.75 xl:pt-26" aria-labelledby="trip-hero-heading">
  <div class="absolute inset-0 overflow-hidden">
    <CmsImage image={bg} alt="" widths={[800, 1600, 2400]} loading="eager" class="size-full object-cover object-bottom" />
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <div class="relative container flex w-full flex-1 flex-col justify-between gap-12.5 py-15 md:gap-20 md:py-20 xl:pt-24 xl:pb-20">
    <div class="flex w-full flex-col items-start gap-6.25 xl:gap-7.5">
      <div class="flex w-full flex-col items-start gap-5 xl:gap-7.5">
        <div class="flex w-full flex-col items-start gap-2.5 xl:gap-3">
          <p class="text-xs leading-none font-bold text-cream/80 uppercase md:text-[15px] xl:text-base">Upcoming mission</p>
          <h1 id="trip-hero-heading" class="text-4xl leading-[1.1] font-bold text-cream text-shadow-2xs md:text-6xl xl:text-7xl">{title}</h1>
        </div>
        <p class="max-w-101 text-base leading-none font-medium text-cream xl:max-w-127.25 xl:text-lg">{description}</p>
      </div>

      <div class="flex w-full max-w-129.75 flex-col gap-4 sm:flex-row xl:max-w-137.5">
        <Button href={SITE_LINKS.call.href} variant="cream" size="lg" class="w-full sm:flex-1">{SITE_LINKS.call.label}</Button>
        <Button href={SITE_LINKS.guide.href} variant="glass" size="lg" class="w-full sm:flex-1">{SITE_LINKS.guide.label}</Button>
      </div>
    </div>

    {/* The dividers only fit once the facts sit on one line, so below xl they wrap as a plain list. */}
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2.5 text-cream md:gap-x-10 md:gap-y-4 xl:justify-between xl:px-12.5">
      {
        facts.map((fact, index) => (
          <li class:list={['flex items-center gap-10', index > 0 && "before:bg-cream/40 before:hidden before:h-10.75 before:w-px before:content-[''] xl:before:block"]}>
            <p class="text-base font-bold md:text-lg xl:text-2xl">{fact}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="pointer-events-none absolute -bottom-3 left-0 z-10 w-full translate-y-1/2 md:-bottom-5">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto w-full" />
  </div>
</section>
