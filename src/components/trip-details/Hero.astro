---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import decor from '@/assets/images/decor-bottom.png';
import CmsImage from '@/components/base/CmsImage.astro';
import { Button } from '@/shared/ui/button';
import { SITE_LINKS } from '@/lib/links';
import { tripFacts } from '@/lib/trip';

interface Props {
  trip: CollectionEntry<'trips'>;
}

const trip = Astro.props.trip.data;
const { hero_title: title, hero_description: description, hero_image: bg } = trip;

// Dates, length, ministry and price all come from the Overview fields — nothing to fill in by hand.
const facts = tripFacts(trip);
---

<section class="relative" aria-labelledby="trip-hero-heading">
  <div class="absolute inset-0 overflow-hidden">
    <CmsImage image={bg} alt="" widths={[800, 1600, 2400]} loading="eager" class="size-full object-cover object-bottom" />
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <div class="relative container flex w-full flex-1 flex-col justify-between gap-20 pt-50 pb-40">
    <div class="flex w-full max-w-195 flex-col items-center text-center xl:items-start xl:text-left">
      <p class="leading-none font-bold text-cream/80 uppercase">Upcoming mission</p>
      <h1 id="trip-hero-heading" class="mt-3 text-4xl  font-bold text-cream text-shadow-2xs md:text-6xl xl:text-[74px]">{title}</h1>
      <p class="mt-7.5 max-w-137.5 text-lg leading-none font-medium text-cream">{description}</p>
      <div class="mt-7.5 flex w-full max-w-137.5 flex-col gap-4 sm:flex-row">
        <Button href={SITE_LINKS.call.href} variant="cream" size="lg" class="flex-1">{SITE_LINKS.call.label}</Button>
        <Button href={SITE_LINKS.guide.href} variant="glass" size="lg" class="flex-1">{SITE_LINKS.guide.label}</Button>
      </div>
    </div>

    <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-cream xl:justify-between xl:px-12.5">
      {
        facts.map((fact, index) => (
          <li class:list={['flex items-center gap-10', index > 0 && "before:bg-cream/40 before:hidden before:h-10.75 before:w-px before:content-[''] xl:before:block"]}>
            <p class="text-2xl  font-bold">{fact}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="pointer-events-none absolute -bottom-5 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto w-full" />
  </div>
</section>
