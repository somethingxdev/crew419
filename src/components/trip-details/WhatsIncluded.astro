---
import type { CollectionEntry } from 'astro:content';

interface Props {
  trip: CollectionEntry<'trips'>;
}

const { included_eyebrow: eyebrow, included_heading: heading, included_items: items } = Astro.props.trip.data;

const lists = [
  { title: 'Included', items: items.filter((item) => item.group === 'included') },
  { title: 'Not Included', items: items.filter((item) => item.group === 'not_included') },
];
---

<section class="py-30" aria-labelledby="whats-included-heading">
  <div class="container flex flex-col gap-12.5 xl:flex-row xl:justify-between xl:gap-20">
    <div class="flex flex-col gap-4">
      <p class="text-muted-foreground leading-none font-bold uppercase">{eyebrow}</p>
      <h2 id="whats-included-heading" class="text-3xl  font-bold md:text-5xl">{heading}</h2>
    </div>

    <div class="grid gap-12.5 sm:grid-cols-2 sm:gap-25 xl:w-full xl:max-w-185">
      {
        lists.map((list) => (
          <div class="flex flex-col gap-5.75">
            <h3 class="text-2xl  font-bold">{list.title}</h3>
            <ul class="flex flex-col gap-3.75">
              {list.items.map((item) => (
                <li class="flex items-center gap-2.5 leading-tight">
                  <span class="bg-primary size-2 shrink-0 rounded-full" aria-hidden="true" />
                  {item.label}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
