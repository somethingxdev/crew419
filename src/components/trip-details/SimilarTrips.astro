---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';
import { tripDates, tripDuration } from '@/lib/trip';

interface Props {
  trip: CollectionEntry<'trips'>;
}

const { trip } = Astro.props;

// Every other published trip (the collection is already limited to published ones), with its category name.
const trips = await Promise.all(
  (await getCollection('trips', (entry) => entry.id !== trip.id)).map(async (entry) => {
    const category = await getEntry(entry.data.category);
    if (!category) throw new Error(`trips/${entry.data.slug}: category "${entry.data.category.id}" does not exist`);
    return { ...entry, categoryName: category.data.name };
  }),
);
---

{
  trips.length > 0 && (
    <section class="py-15" aria-labelledby="similar-trips-heading">
      <div class="container">
        <div class="flex flex-col items-center gap-4 text-center">
          <p class="text-muted-foreground leading-none font-bold uppercase">Explore more</p>
          <h2 id="similar-trips-heading" class="text-3xl  font-bold md:text-5xl">Similar Mission Trips</h2>
        </div>

        <ul class="mt-12.5 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
          {trips.map(({ data, categoryName }) => (
            <li>
              <article class="bg-cream flex h-full flex-col rounded-lg p-5">
                <CmsImage image={data.card_image} alt={data.title} widths={[400, 800]} class="h-65 w-full rounded-lg object-cover" />

                <div class="mt-5 flex flex-1 flex-col gap-6.5">
                  <div class="flex flex-col gap-2.5">
                    <p class="text-muted-foreground leading-none font-bold uppercase">{categoryName}</p>
                    <h3 class="text-2xl  font-bold">{data.title}</h3>
                  </div>

                  <div class="flex flex-col gap-2.5 leading-none">
                    <p>{tripDates(data)}</p>
                    <p>{data.price}</p>
                    <p>{tripDuration(data)}</p>
                  </div>
                </div>

                <a
                  href={`/trips/${data.slug}`}
                  class="text-muted-foreground border-muted-foreground hover:text-foreground hover:border-foreground mt-5 w-fit border-b pb-2 leading-none font-black uppercase transition-colors"
                >
                  View trip
                </a>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
