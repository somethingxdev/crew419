---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import { tripPath } from '@/lib/links';
import { tripDates, tripDuration, tripSlug } from '@/lib/trip';

interface Props {
  trip: CollectionEntry<'trips'>;
}

const { trip } = Astro.props;

// Every other published trip (the collection is already limited to published ones), with its category name and region path.
const trips = await Promise.all(
  (await getCollection('trips', (entry) => entry.id !== trip.id)).map(async (entry) => {
    const category = await getEntry(entry.data.category);
    if (!category) throw new Error(`trips/${entry.data.title}: category "${entry.data.category.id}" does not exist`);

    const region = await getEntry(entry.data.region);
    if (!region) throw new Error(`trips/${entry.data.title}: region "${entry.data.region.id}" is not published`);

    const country = await getEntry(entry.data.country);
    if (!country) throw new Error(`trips/${entry.data.title}: country "${entry.data.country.id}" does not exist`);

    return { ...entry, categoryName: category.data.name, href: tripPath(region.data.slug, tripSlug(country.data.name, entry.data.title)) };
  }),
);
---

{
  trips.length > 0 && (
    <section class="py-15" aria-labelledby="similar-trips-heading">
      <div class="container">
        <SectionHeading id="similar-trips-heading" eyebrow="Explore more" heading="Similar Mission Trips" />

        <ul class="mt-12.5 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
          {trips.map(({ data, categoryName, href }) => (
            <li>
              <article class="bg-cream flex h-full flex-col rounded-lg p-5">
                <CmsImage image={data.card_image} alt={data.title} widths={[400, 800]} class="h-65 w-full rounded-lg object-cover" />

                <div class="mt-5 flex flex-1 flex-col gap-6.5">
                  <div class="flex flex-col gap-2.5">
                    <p class="text-muted-foreground leading-none font-bold uppercase">{categoryName}</p>
                    <h3 class="text-2xl  font-bold">{data.title}</h3>
                  </div>

                  <div class="flex flex-col gap-2.5 leading-none">
                    <p>{tripDates(data)}</p>
                    <p>{data.price}</p>
                    <p>{tripDuration(data)}</p>
                  </div>
                </div>

                <a
                  href={href}
                  class="text-muted-foreground border-muted-foreground hover:text-foreground hover:border-foreground mt-5 w-fit border-b pb-2 leading-none font-black uppercase transition-colors"
                >
                  View trip
                </a>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
