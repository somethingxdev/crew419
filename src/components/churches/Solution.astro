---
import { Image } from 'astro:assets';
import decorBottom from '@/assets/images/decor-bottom.png';
import decorTop from '@/assets/images/decor-top.png';
import bg from '@/assets/images/churches/solution-bg.png';

const features = [
  {
    num: '01',
    title: 'Customized Mission Planning',
    text: 'Every itinerary is built around your group’s goals.',
  },
  {
    num: '02',
    title: 'Trusted Local Ministry Partners',
    text: 'Serve alongside churches and ministries already making an impact.',
  },
  {
    num: '03',
    title: 'Logistics & Travel Management',
    text: 'Flights, accommodations, transportation, insurance guidance, and scheduling – all coordinated together.',
  },
  {
    num: '04',
    title: 'Discipleship Every Step of the Way',
    text: 'Pre-trip preparation, daily devotionals in the field, and post-trip follow-up help turn a mission trip into lifelong growth.',
  },
];
---

<section id="solution" class="relative z-10 py-15 md:py-30 lg:py-37.5" aria-labelledby="solution-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[1600, 2400]} class="size-full object-cover object-bottom" />
    <div class="absolute inset-0 bg-black/10"></div>
  </div>

  <div class="container">
    <div class="relative z-10 flex w-full flex-col justify-between gap-10 xl:flex-row xl:items-start">
      <div class="flex max-w-215 flex-col gap-7.5 text-cream">
        <div class="flex flex-col gap-3.75">
          <p class="leading-none font-bold uppercase opacity-80">Our solution</p>
          <h2 id="solution-heading" class="text-3xl  font-bold text-shadow-2xs md:text-5xl">We Handle the Details So Your Church Can Focus on Ministry</h2>
        </div>
        <p class="max-w-144 text-lg leading-none font-medium">
          Crew419 partners with churches to design mission experiences that are safe, well-organized, and centered on discipleship. We coordinate logistics, connect you with trusted local ministries,
          and prepare your team before they ever board a plane.
        </p>
      </div>

      <div class="flex w-full max-w-130 shrink-0 flex-col gap-5">
        {
          features.map((item) => (
            <article class="flex flex-col gap-5 rounded-lg bg-cream p-7.5">
              <div class="flex flex-col gap-3.75">
                <p class="text-primary text-2xl  font-bold">{item.num}</p>
                <h3 class="text-2xl  font-bold">{item.title}</h3>
              </div>
              <p class="leading-none">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute top-5 left-0 z-10 w-full -translate-y-1/2">
    <Image src={decorTop} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
  <div class="pointer-events-none absolute bottom-5 left-0 z-10 w-full translate-y-[70%]">
    <Image src={decorBottom} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
</section>
