---
import { getCollection } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';

type PartnersWhere = 'about' | 'audience';

interface Props {
  /** Which partner set to show — `partners.show_on_about` / `partners.show_on_audience_pages` in Directus. */
  where: PartnersWhere;
}

const { where } = Astro.props;

const partners = (await getCollection('partners', ({ data }) => (where === 'about' ? data.show_on_about : data.show_on_audience_pages)))
  .map(({ data }) => data)
  .sort((a, b) => a.sort - b.sort);
---

<section class="overflow-x-clip pb-15" aria-label="Partners">
  <div class="flex justify-center gap-5">
    {
      partners.map((partner) => {
        const Tag = partner.url ? 'a' : 'div';
        return (
          <Tag
            class="bg-cream flex h-40 w-75 shrink-0 items-center justify-center rounded-lg"
            {...(partner.url ? { href: partner.url, target: '_blank', rel: 'noopener noreferrer', 'aria-label': partner.name } : {})}
          >
            {partner.logo ? (
              <CmsImage image={partner.logo} alt={partner.name} widths={[300, 600]} class="max-h-24 w-auto max-w-56 object-contain" />
            ) : (
              <p class="text-muted-foreground leading-none font-bold uppercase">{partner.name}</p>
            )}
          </Tag>
        );
      })
    }
  </div>
</section>
