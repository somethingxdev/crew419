---
import { Image } from 'astro:assets';
import bg from '@/assets/images/cta/bg-3.png';
import { Button } from '@/shared/ui/button';

// Static CTA — the same on every visit, so it is not editable in the CMS.
const title = 'Let’s Plan Your Church’s Next Mission';
const text = 'We’ll help you build a mission experience that strengthens your church and impacts communities around the world.';
const primaryLabel = 'Book a 30–minute call';
const primaryHref = '/contact';
const secondaryLabel = 'Contact our team';
const secondaryHref = '/contact';
---

<section class="py-15" aria-labelledby="churches-cta-heading">
  <div class="container">
    <div class="relative flex min-h-125 overflow-hidden rounded-2xl md:h-150">
      <div class="absolute inset-0 overflow-hidden">
        <Image src={bg} alt="" widths={[1600, 3000]} class="size-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>

      <div class="relative z-10 mx-auto flex w-full max-w-155 flex-col items-center justify-center gap-7.5 px-5 py-15 text-center text-cream md:py-0">
        <div class="flex w-full flex-col items-center gap-6">
          <h2 id="churches-cta-heading" class="text-3xl  font-bold md:text-5xl">{title}</h2>
          <p class="max-w-104 leading-none">{text}</p>
        </div>
        <div class="flex flex-col items-center gap-4 sm:flex-row">
          <Button href={primaryHref} variant="cream" size="lg">{primaryLabel}</Button>
          <Button href={secondaryHref} variant="glass" size="lg" class="w-62 max-w-full">{secondaryLabel}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
