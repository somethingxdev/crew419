---
import { Image } from 'astro:assets';
import bg from '@/assets/images/hero/trips.png';
import polaroid from '@/assets/images/hero/trips-polaroid.jpg';
import decor from '@/assets/images/decor-bottom.png';
import { SITE_LINKS } from '@/lib/links';
import { Button } from '@/shared/ui/button';

// Static hero — the wording and the photos are part of the design, so nothing here is editable in the CMS.
const eyebrow = 'Discover your next mission';
const description = 'Whether through sports, construction, medical outreach, or evangelism, every Crew419 trip strengthens your faith while making a lasting impact.';

// "Find the Mission God Is Calling You To" — laid out around the polaroid, so the words are split by hand.
const lead = 'Find the';
const accent = 'Mission';
const tailStart = 'God Is';
const tailAccent = 'Calling';
const tailEnd = 'You To';
const tailText = `${tailStart} ${tailAccent} ${tailEnd}`;
---

<section class="relative flex min-h-161.25 flex-col pt-20 md:min-h-201.75 xl:min-h-226 xl:pt-26" aria-labelledby="trips-hero-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[800, 1600, 2400]} loading="eager" class="size-full object-cover object-bottom" />
  </div>

  <div class="relative w-full px-3.5 py-6 md:px-5 md:py-15 xl:px-12 xl:pt-24 xl:pb-20">
    <div class="mx-auto flex w-full max-w-7xl flex-col items-center">
      {/* Below xl the heading runs as three staggered lines with the polaroid pulled up over them. */}
      <div class="flex w-full flex-col xl:grid xl:grid-cols-[minmax(0,1fr)_auto_max-content] xl:items-start">
        <div class="text-secondary flex flex-col items-start text-left xl:pt-5">
          <p class="text-cream text-xs leading-none font-bold uppercase xl:text-base xl:text-secondary/80">{eyebrow}</p>
          <h1 id="trips-hero-heading" class="text-shadow-2xs z-10 mt-2.5 text-[35px] leading-[1.1] font-bold md:text-6xl xl:mt-3 xl:text-7xl">
            <span class="xl:block">{lead} </span>
            <span class="uppercase xl:mt-0 xl:block xl:pl-40 xl:text-[72px] xl:text-primary">{accent}</span>
            <span class="sr-only">{tailText}</span>
          </h1>
        </div>

        {/* Second and third heading lines: centred, then right-aligned. */}
        <div
          class="text-secondary text-shadow-2xs z-10 order-2 flex w-full flex-col items-center text-[35px] leading-[1.1] font-bold md:text-6xl xl:order-3 xl:w-auto xl:items-end xl:self-end xl:text-7xl"
          aria-hidden="true"
        >
          {/* w-fit ties the last line to the line above it instead of the container; the shift keeps it clear of the polaroid. */}
          <span class="block w-fit">
            <span class="block">
              <span>{tailStart} </span>
              <span class="text-primary">{tailAccent}</span>
            </span>
            <span class="block translate-x-[1.25em] text-right md:translate-x-[2.4em] xl:translate-x-0">{tailEnd}</span>
          </span>
        </div>

        <figure class="order-3 -mt-20 w-54 shrink-0 translate-x-3 rotate-6 self-center md:-mt-32 md:w-62 xl:order-2 xl:mt-0 xl:w-80 xl:self-auto">
          <div class="bg-cream flex flex-col gap-2.5 rounded-sm p-1.25 pb-7.5 shadow-polaroid md:p-2.5 md:pb-7.5 xl:p-3 xl:pb-7.5">
            <Image src={polaroid} alt="A mission team standing together on a hillside overlooking mountains" widths={[600, 1200]} class="aspect-297/245 w-full rounded-sm object-cover" />
            <p class="text-secondary text-sm leading-none font-medium text-justify">{description}</p>
          </div>
        </figure>
      </div>

      <div class="mt-6.25 flex w-full max-w-130 flex-col items-center justify-center gap-2.5 md:mt-7.5 md:flex-row md:gap-4">
        <Button href={SITE_LINKS.call.href} variant="cream" size="lg" class="w-full md:flex-1">{SITE_LINKS.call.label}</Button>
        <Button href="#destinations" variant="glass" size="lg" class="w-full md:flex-1">Find Your Destination</Button>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute -bottom-3 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto w-full bg-top" />
  </div>
</section>
