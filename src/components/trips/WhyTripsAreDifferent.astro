---
import { Image } from 'astro:assets';
import bg from '@/assets/images/backgrounds/trips-why.png';
import decorBottom from '@/assets/images/decor-bottom.png';
import decorTop from '@/assets/images/decor-top.png';
import { getSingleton } from '@/lib/content';

const {
  trips_hub_why_eyebrow: eyebrow,
  trips_hub_why_heading: heading,
  trips_hub_why_features: features,
} = await getSingleton('website_content');
---

<section id="why-different" class="relative z-20 py-15 md:py-30 lg:py-40" aria-labelledby="why-different-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[1600, 2400]} class="size-full object-cover object-bottom" />
    <div class="absolute inset-0 bg-black/5"></div>
  </div>

  <div class="container">
    <div class="relative z-10 flex w-full flex-col justify-between gap-10 xl:flex-row xl:items-start">
      <div class="flex max-w-134 flex-col gap-3.75 text-cream">
        <p class="leading-none font-bold uppercase opacity-80">{eyebrow}</p>
        <h2 id="why-different-heading" class="text-3xl  font-bold text-shadow-2xs md:text-5xl">{heading}</h2>
      </div>

      <div class="flex w-full max-w-130 flex-col gap-5">
        {
          features.map((item) => (
            <article class="flex flex-col gap-5 rounded-lg bg-cream p-7.5">
              <div class="flex flex-col gap-3.75">
                <p class="text-primary text-2xl  font-bold">{item.num}</p>
                <h3 class="text-2xl  font-bold">{item.title}</h3>
              </div>
              <p class="leading-none">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute top-0 left-0 z-10 w-full -translate-y-1/2">
    <Image src={decorTop} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
  <div class="pointer-events-none absolute bottom-0 left-0 z-10 w-full translate-y-[63%]">
    <Image src={decorBottom} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
</section>
