---
import CmsImage from '@/components/base/CmsImage.astro';
import PhotoPairSection from '@/components/shared/PhotoPairSection.astro';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

const {
  trips_hub_custom_eyebrow: eyebrow,
  trips_hub_custom_heading: heading,
  trips_hub_custom_text: text,
  trips_hub_custom_photo_left: photoLeft,
  trips_hub_custom_photo_right: photoRight,
} = await getSingleton('website_content');

// First paragraph is the lead line, the rest is body copy.
const [lead, ...paragraphs] = text.split(/\n\s*\n/);
---

<PhotoPairSection id="custom-group-trips" labelledBy="custom-group-heading" class="py-30">
  <CmsImage slot="image-left" image={photoLeft} alt="A white country church with a steeple under an overcast sky" widths={[600, 1200]} />
  <CmsImage slot="image-right" image={photoRight} alt="School children in uniforms running toward the camera on a dirt path" widths={[600, 1200]} />

  <div class="flex w-full flex-col items-start gap-4">
    <p class="text-muted-foreground leading-none font-bold uppercase">{eyebrow}</p>
    <h2 id="custom-group-heading" class="max-w-158.25 text-3xl font-bold md:text-5xl">{heading}</h2>
  </div>

  <div class="flex w-full max-w-138 flex-col items-start gap-7.5">
    <div class="flex w-full flex-col items-start gap-4 text-foreground">
      <p class="text-lg leading-none font-medium">{lead}</p>
      {paragraphs.map((paragraph) => <p class="leading-none">{paragraph}</p>)}
    </div>

    <div class="flex w-full flex-col items-stretch gap-4 sm:flex-row sm:items-start">
      <Button href="/contact" class="w-full sm:w-67">Plan a custom trip</Button>
      <Button href="/trips/custom" variant="soft" class="w-full sm:w-67">Learn More</Button>
    </div>
  </div>
</PhotoPairSection>
