---
import { Image } from 'astro:assets';
import decor from '@/assets/images/decor-bottom.png';
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

const { home_hero_eyebrow: eyebrow, home_hero_title: title, home_hero_description: description, home_hero_image: image } = await getSingleton('website_content');
const { default_primary_cta_label: ctaLabel, default_primary_cta_href: ctaHref } = await getSingleton('global');

// "Live Missionally. Here I Am. Send Me." → three styled lines.
const [line1, line2, line3] = title.split(/(?<=\.)\s+/);
---

<section class="relative flex min-h-150 flex-col pt-20 xl:min-h-220 xl:pt-26" aria-label="Hero">
  <div class="absolute inset-0 overflow-hidden">
    <CmsImage image={image} alt="" widths={[800, 1600, 2400]} loading="eager" class="size-full object-cover object-bottom-right" />
  </div>

  <div class="relative w-full px-5 py-15 md:px-12 xl:pt-40 xl:pb-0">
    <div class="mx-auto w-full max-w-375">
      <p class="leading-none font-bold text-muted-foreground uppercase whitespace-pre-line">{eyebrow}</p>

      <h1 class="mt-3 flex flex-col text-4xl leading-none font-bold text-foreground md:text-6xl xl:text-7xl">
        <span class="uppercase">{line1}</span>
        <span class="pl-16 md:pl-24 xl:pl-36">{line2}</span>
        <span class="text-primary flex flex-wrap items-start gap-x-6 gap-y-8">
          {line3}
          <span class="flex flex-col items-start gap-5 pt-1 xl:pt-6">
            <span class="text-muted-foreground max-w-88 font-sans text-lg leading-none font-medium normal-case">{description}</span>
            <Button href={ctaHref} size="lg" class="w-82 max-w-full">{ctaLabel}</Button>
          </span>
        </span>
      </h1>
    </div>
  </div>

  <div class="pointer-events-none absolute -bottom-5 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto bg-top w-full" />
  </div>
</section>
