---
import { Image } from 'astro:assets';
import decor from '@/assets/images/decor-bottom.png';
import bg from '@/assets/images/home/hero/bg.png';
import { Button } from '@/shared/ui/button';
---

<section class="relative flex min-h-150 flex-col pt-20 xl:min-h-220 xl:pt-26" aria-label="Hero">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[800, 1600, 2400]} loading="eager" class="size-full object-cover object-right-bottom" />
  </div>

  <div class="relative w-full px-5 py-15 md:px-12 xl:pt-40 xl:pb-0">
    <div class="mx-auto w-full max-w-375">
      <p class="leading-none font-bold text-muted-foreground uppercase">
        Matthew 4:19 –<br />
        “Follow Me, and I will make you fishers of men.”
      </p>

      <h1 class="mt-3 flex flex-col text-4xl leading-none font-bold text-foreground md:text-6xl xl:text-7xl">
        <span class="uppercase">Live Missionally</span>
        <span class="pl-16 md:pl-24 xl:pl-36">Here I Am.</span>
        <span class="text-primary flex flex-wrap items-start gap-x-6 gap-y-8">
          Send Me.
          <span class="flex flex-col items-start gap-5 pt-1 xl:pt-6">
            <span class="text-muted-foreground max-w-88 font-sans text-lg leading-none font-medium normal-case">
              Trusted mission trips that equip believers to serve, grow, and make a lasting impact.
            </span>
            <Button href="/contact" size="lg" class="w-82 max-w-full">Book a 30–minute call</Button>
          </span>
        </span>
      </h1>
    </div>
  </div>

  <div class="pointer-events-none absolute -bottom-5 left-0 z-10 w-full translate-y-1/2">
    <Image src={decor} alt="" widths={[1600, 3200]} class="h-auto bg-top w-full" />
  </div>
</section>
