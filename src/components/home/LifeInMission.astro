---
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import { getCollection } from 'astro:content';
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

const { life_in_mission_heading: heading, life_in_mission_instagram: instagramLabel, instagram_url: instagramUrl, site_name: siteName } = await getSingleton('global');

const photos = (await getCollection('life_in_mission')).map(({ data }) => data).sort((a, b) => a.sort - b.sort);

// "Life in Mission" → last word highlighted.
const words = heading.split(' ');
const lastWord = words.pop();
const leadWords = words.join(' ');
---

<section class="overflow-x-hidden py-10" aria-labelledby="life-in-mission-heading">
  <div class="container">
    <div class="flex items-center justify-between gap-5">
      <h2 id="life-in-mission-heading" class="max-w-40 text-3xl leading-[1.05] font-bold sm:max-w-none md:text-5xl md:leading-none">
        {leadWords} <span class="text-primary">{lastWord}</span>
      </h2>
      <Button class="px-7.5 max-sm:h-11.5 sm:px-10" href={instagramUrl} size="lg" target="_blank" rel="noopener noreferrer" aria-label={`${siteName} on Instagram`}>
        {instagramLabel}
        <ArrowRight class="size-6" />
      </Button>
    </div>

    <div class="mt-6 flex justify-center pt-3 pb-6">
      <ul class="flex gap-3">
        {
          photos.map((photo, index) => (
            <li class:list={['bg-cream size-40 shrink-0 rounded-lg p-1 shadow-polaroid sm:size-50 md:size-62', index % 2 === 0 ? 'translate-y-4 -rotate-6' : 'rotate-6']}>
              <CmsImage image={photo.image} alt={photo.alt} widths={[800]} class="size-full rounded-sm object-cover" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
