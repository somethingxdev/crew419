---
import { Image, type LocalImageProps } from 'astro:assets';
import ArrowLeft from '@tabler/icons/outline/arrow-left.svg';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import emilyCarter from '@/assets/images/home/impact/emily-carter.png';
import johnsonFamily from '@/assets/images/home/impact/johnson-family.png';
import pastorDaniel from '@/assets/images/home/impact/pastor-daniel.png';
import Quote from '@/icons/quote.svg';

interface Story {
  name: string;
  role: string;
  quote: string;
  image: LocalImageProps['src'];
  alt: string;
}

const stories: Story[] = [
  {
    name: 'Pastor Daniel',
    role: 'Local Church Partner',
    quote: '“Mission teams encouraged our church and helped us reach families we could never have served on our own.”',
    image: pastorDaniel,
    alt: 'Pastor Daniel smiling in a light blue shirt',
  },
  {
    name: 'Emily Carter',
    role: 'Student Volunteer',
    quote: '“Serving in Kenya changed the way I see my faith. I returned home with a deeper purpose and a heart for serving others.”',
    image: emilyCarter,
    alt: 'Emily Carter smiling outdoors in a white sweater',
  },
  {
    name: 'The Johnson Family',
    role: 'Mission Team Participants',
    quote: '“Our first mission trip transformed our family. We left to serve others and came home changed ourselves.”',
    image: johnsonFamily,
    alt: 'The Johnson family standing together outdoors',
  },
  {
    name: 'Pastor Daniel',
    role: 'Local Church Partner',
    quote: '“Mission teams encouraged our church and helped us reach families we could never have served on our own.”',
    image: pastorDaniel,
    alt: 'Pastor Daniel smiling in a light blue shirt',
  },
  {
    name: 'Emily Carter',
    role: 'Student Volunteer',
    quote: '“Serving in Kenya changed the way I see my faith. I returned home with a deeper purpose and a heart for serving others.”',
    image: emilyCarter,
    alt: 'Emily Carter smiling outdoors in a white sweater',
  },
  {
    name: 'The Johnson Family',
    role: 'Mission Team Participants',
    quote: '“Our first mission trip transformed our family. We left to serve others and came home changed ourselves.”',
    image: johnsonFamily,
    alt: 'The Johnson family standing together outdoors',
  },
];
---

<section id="stories" class="overflow-x-hidden py-15" aria-labelledby="stories-heading" data-stories>
  <div class="relative container">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-8 text-center">
      <div class="flex flex-col items-center gap-4">
        <p class="text-muted-foreground leading-none font-bold uppercase">Real lives. Real impact.</p>
        <h2 id="stories-heading" class="text-3xl  font-bold md:text-5xl">Every Gift Has a Story</h2>
      </div>
      <p class="text-foreground max-w-md leading-none">
        Every mission is made possible by people who choose to give. Your generosity helps believers serve, churches grow, and communities experience the hope of the Gospel.
      </p>
    </div>

    <div class="mt-6 flex justify-center gap-4 lg:absolute lg:right-12 lg:bottom-0 lg:mt-0">
      <button type="button" class="flex size-10 items-center justify-center rounded-full bg-secondary text-secondary-foreground transition-opacity hover:opacity-90 disabled:pointer-events-none disabled:opacity-40" aria-label="Previous story" data-stories-prev>
        <ArrowLeft class="size-6" />
      </button>
      <button type="button" class="flex size-10 items-center justify-center rounded-full bg-secondary text-secondary-foreground transition-opacity hover:opacity-90 disabled:pointer-events-none disabled:opacity-40" aria-label="Next story" data-stories-next>
        <ArrowRight class="size-6" />
      </button>
    </div>
  </div>

  <div class="mt-10 overflow-hidden" data-stories-viewport>
    <ul class="flex touch-pan-y gap-5 pl-5 md:pl-12" data-stories-container>
      {
        stories.map((story) => (
          <li class="min-w-0 flex-[0_0_min(690px,calc(100vw-2.5rem))]">
            <article class="bg-secondary text-cream flex h-full flex-col items-stretch gap-5 rounded-lg p-5 md:flex-row md:items-center md:gap-7.5 md:p-7.5">
              <div class="flex min-h-60 flex-1 flex-col justify-between md:h-75 md:min-h-0">
                <Quote class="h-24 w-28 shrink-0 text-cream md:h-35 md:w-40" aria-hidden="true" />
                <div class="flex flex-col gap-4">
                  <div class="flex flex-col gap-2.5">
                    <h3 class="text-2xl  font-bold">{story.name}</h3>
                    <p class="leading-none font-bold uppercase opacity-60">{story.role}</p>
                  </div>
                  <p class="leading-none">{story.quote}</p>
                </div>
              </div>
              <Image src={story.image} alt={story.alt} widths={[500]} class="h-60 w-full rounded-lg object-cover md:h-75 md:w-62.5 md:shrink-0" />
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import EmblaCarousel from 'embla-carousel';

  const section = document.querySelector<HTMLElement>('[data-stories]');
  const viewport = section?.querySelector<HTMLElement>('[data-stories-viewport]');
  const prev = section?.querySelector<HTMLButtonElement>('[data-stories-prev]');
  const next = section?.querySelector<HTMLButtonElement>('[data-stories-next]');

  if (section && viewport && prev && next) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const embla = EmblaCarousel(viewport, {
      align: 'start',
      containScroll: 'trimSnaps',
      duration: reduced ? 0 : 25,
      watchDrag: !reduced,
    });

    const toggleButtons = () => {
      prev.disabled = !embla.canScrollPrev();
      next.disabled = !embla.canScrollNext();
    };

    prev.addEventListener('click', () => embla.scrollPrev());
    next.addEventListener('click', () => embla.scrollNext());
    embla.on('select', toggleButtons);
    embla.on('reInit', toggleButtons);
    toggleButtons();
  }
</script>
