---
import CmsImage from '@/components/base/CmsImage.astro';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

interface Props {
  class?: string;
}

const { class: className = 'py-15' } = Astro.props;

// The copy is part of the design and identical on every page — only the cards come from the CMS.
const eyebrow = 'Find your mission path';
const heading = "Everyone Has a Place in God's Mission";

const { cards: pathCards } = await getSingleton('mission_paths');

// Alternating card tilt (styling only — content comes from the CMS).
const rotations = ['-rotate-2', 'rotate-3', '-rotate-3', 'rotate-2'];

const cards = [...pathCards, ...pathCards].map((card, index) => ({ ...card, rotate: rotations[index % rotations.length] }));
---

<section id="find-your-mission-path" class:list={['group/path relative overflow-x-clip', className]} aria-labelledby="find-your-mission-path-heading" data-mission-path>
  <div
    class="relative z-0 mx-auto flex max-w-[63.7rem] flex-col items-center gap-4 px-5 text-center group-data-scroll-active/path:absolute group-data-scroll-active/path:inset-0 group-data-scroll-active/path:z-0 group-data-scroll-active/path:justify-center"
  >
    <p class="text-muted-foreground text-xs leading-none font-bold uppercase md:text-base">{eyebrow}</p>
    <h2 id="find-your-mission-path-heading" class="text-foreground text-3xl font-bold md:text-5xl xl:text-[4.625rem]">{heading}</h2>
  </div>

  <div class="relative z-10 mt-10 w-full group-data-scroll-active/path:mt-0 group-data-scroll-active/path:overflow-x-clip" data-mission-path-viewport>
    <div
      class="flex flex-wrap items-center justify-center gap-12 px-5 group-data-scroll-active/path:flex-nowrap group-data-scroll-active/path:justify-start group-data-scroll-active/path:px-0 group-data-scroll-active/path:will-change-transform"
      data-mission-path-track
    >
      {
        cards.map((card) => (
          <article class:list={['bg-cream flex min-h-126.5 w-[min(380px,calc(100vw-2.5rem))] shrink-0 flex-col justify-between rounded-lg p-5 shadow-polaroid', card.rotate]}>
            <div class="flex flex-col gap-5">
              <CmsImage image={card.image} alt={card.alt} widths={[680]} class="h-65 w-full rounded-lg object-cover" />
              <div class="text-foreground flex flex-col gap-5">
                <h3 class="text-2xl  font-bold">{card.title}</h3>
                <p class="leading-none">{card.text}</p>
              </div>
            </div>
            <Button href={card.href} class="w-full">
              {card.cta}
            </Button>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('[data-mission-path]');
  const track = section?.querySelector<HTMLElement>('[data-mission-path-track]');

  if (section && track) {
    const mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      section.dataset.scrollActive = '';

      const getStartX = () => section.offsetWidth;
      const getEndX = () => -(track.scrollWidth - section.offsetWidth + 48);

      gsap.set(track, { x: getStartX() });

      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: section,
          start: 'center center',
          end: () => `+=${Math.max(track.scrollWidth, section.offsetWidth) * 1.5}`,
          pin: true,
          scrub: 1,
          invalidateOnRefresh: true,
        },
      });

      tl.fromTo(track, { x: getStartX }, { x: getEndX, duration: 1, immediateRender: true }, 0.15).to({}, { duration: 0.15 });

      return () => {
        delete section.dataset.scrollActive;
      };
    });
  }
</script>
