---
import { Image } from 'astro:assets';
import bg from '@/assets/images/backgrounds/how-it-works.png';
import decorBottom from '@/assets/images/decor-bottom.png';
import decorTop from '@/assets/images/decor-top.png';
import { getSingleton } from '@/lib/content';
import { Button } from '@/shared/ui/button';

// The background is part of the design and identical on every page that shows this section.
const { eyebrow, heading, text, steps, cta_label: ctaLabel, cta_href: ctaHref } = await getSingleton('how_it_works');

// Per-card colour/offset (styling only — content comes from the CMS).
const cardClasses = ['bg-[#576d87] md:left-2.5 md:top-2 md:-rotate-3', 'bg-[#2b4767] md:left-30 md:top-12 md:rotate-3', 'bg-secondary md:left-16 md:top-20'];
---

<section id="how-it-works" class="relative py-15 md:py-0" aria-labelledby="how-it-works-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[1600, 2400]} class="size-full object-cover object-bottom" />
    <div class="absolute inset-0 bg-black/20"></div>
  </div>
  <div class="container">
    <div class="relative overflow-hidden py-40 md:py-52" data-how-it-works-stage>
      <div class="relative mx-auto flex flex-col items-center gap-10">
        <div class="flex flex-col gap-8 text-center text-cream">
          <div class="flex flex-col gap-4">
            <p class="leading-none font-bold uppercase opacity-65">{eyebrow}</p>
            <h2 id="how-it-works-heading" class="text-3xl leading-none font-bold md:text-5xl">{heading}</h2>
          </div>
          <p class="leading-none">{text}</p>
        </div>

        <div class="flex w-full flex-col items-center gap-5 md:relative md:block md:h-105 md:w-115">
          {
            steps.map((item, index) => (
              <article
                data-step-card
                class:list={[
                  'flex h-85 w-full max-w-82 flex-col justify-between rounded-lg border border-white/15 p-8 text-cream shadow-[0px_4px_10px_rgba(0,0,0,0.1)] md:absolute md:w-82',
                  cardClasses[index],
                ]}
              >
                <div class="flex flex-col gap-5">
                  <p class="leading-none font-bold uppercase opacity-50">{item.step_label}</p>
                  <h3 class="text-2xl leading-none font-bold">{item.title}</h3>
                </div>
                <p class="leading-none">{item.text}</p>
              </article>
            ))
          }
        </div>

        <Button href={ctaHref} size="lg" class="w-82 max-w-full">{ctaLabel}</Button>
      </div>
    </div>

    <div class="pointer-events-none absolute top-0 left-0 z-10 w-full -translate-y-1/2">
      <Image src={decorTop} alt="" widths={[1600]} class="h-auto w-full" />
    </div>
    <div class="pointer-events-none absolute bottom-0 left-0 z-10 w-full translate-y-[63%]">
      <Image src={decorBottom} alt="" widths={[1600]} class="h-auto w-full" />
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('#how-it-works');
  const stage = section?.querySelector<HTMLElement>('[data-how-it-works-stage]');

  if (section && stage) {
    const cards = gsap.utils.toArray<HTMLElement>('[data-step-card]', section);
    const mm = gsap.matchMedia();

    const hiddenY = (card: HTMLElement) => {
      const currentY = Number(gsap.getProperty(card, 'y')) || 0;
      const stageRect = stage.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      return stageRect.bottom - (cardRect.top - currentY);
    };

    mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline({
        defaults: { ease: 'power1.out' },
        scrollTrigger: {
          trigger: section,
          start: 'center center',
          end: `+=${cards.length * 600}`,
          pin: true,
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      cards.forEach((card) => {
        tl.fromTo(card, { y: () => hiddenY(card) }, { y: 0, duration: 1, immediateRender: true });
      });
    });

    mm.add('(max-width: 767px) and (prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline({
        defaults: { ease: 'power1.out' },
        scrollTrigger: {
          trigger: section,
          start: 'top 60%',
          end: 'center 40%',
          scrub: 1,
        },
      });

      cards.forEach((card) => {
        tl.from(card, { y: 400, duration: 1 });
      });
    });
  }
</script>
