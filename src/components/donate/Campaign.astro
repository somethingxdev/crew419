---
import { Image } from 'astro:assets';
import decorBottom from '@/assets/images/decor-bottom.png';
import decorTop from '@/assets/images/decor-top.png';
import bg from '@/assets/images/donate/campaign-bg.png';
import photo from '@/assets/images/donate/campaign-photo.png';
import { Button } from '@/shared/ui/button';
import { Progress } from '@/shared/ui/progress';

const raised = 84350;
const goal = 150000;
---

<section class="relative z-10 py-15 md:py-30 lg:py-40" aria-labelledby="campaign-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[1600, 2400]} class="size-full object-cover object-center" />
    <div class="absolute inset-0 bg-[#cecece]/5"></div>
  </div>

  <div class="relative z-10 container flex flex-col items-center gap-12.5 xl:flex-row xl:items-center xl:justify-between">
    <div class="flex w-full max-w-164 flex-col items-start gap-12.5">
      <div class="flex w-full flex-col gap-10">
        <div class="flex max-w-151 flex-col gap-7.5">
          <div class="flex flex-col gap-4">
            <p class="text-muted-foreground leading-none font-bold uppercase">Current campaign</p>
            <h2 id="campaign-heading" class="text-3xl font-bold md:text-5xl">2026 Fishing Drive</h2>
          </div>
          <p class="max-w-90 leading-none">Help us send more believers into God’s mission during the 2026 mission season.</p>
        </div>

        <div class="flex w-full flex-col gap-5">
          <Progress value={raised} max={goal} variant="primary" label="Campaign progress" class="h-2.75 bg-cream" />

          <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex gap-12.5">
              <div class="flex flex-col gap-1.25">
                <p class="text-muted-foreground leading-none font-bold uppercase">Raised</p>
                <p class="text-2xl font-bold">${raised.toLocaleString('en-US')}</p>
              </div>
              <div class="flex flex-col gap-1.25">
                <p class="text-muted-foreground leading-none font-bold uppercase">Goal</p>
                <p class="text-2xl font-bold">${goal.toLocaleString('en-US')}</p>
              </div>
            </div>
            <div class="flex flex-col gap-1.25">
              <p class="text-muted-foreground leading-none font-bold uppercase">Days Remaining</p>
              <p class="text-2xl font-bold">127 Days Left</p>
            </div>
          </div>
        </div>
      </div>

      <Button href="#join-mission" size="lg" class="w-82.5 max-w-full">Support the Campaign</Button>
    </div>

    <figure class="bg-cream mx-auto w-full max-w-131 rotate-3 rounded-sm px-3 pt-3 pb-15 shadow-[0_4px_7.5px_rgba(0,0,0,0.2)] xl:mx-0">
      <Image src={photo} alt="A mission team standing with local partners beside a fishing boat" widths={[800, 1200]} class="aspect-499/348 w-full rounded-sm object-cover" />
    </figure>
  </div>

  <div class="pointer-events-none absolute top-0 left-0 z-10 w-full -translate-y-1/2">
    <Image src={decorTop} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
  <div class="pointer-events-none absolute bottom-0 left-0 z-10 w-full translate-y-[63%]">
    <Image src={decorBottom} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
</section>
