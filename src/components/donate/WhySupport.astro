---
import { getSingleton } from '@/lib/content';

const { donate_why_eyebrow: eyebrow, donate_why_heading: heading, donate_why_text: text } = await getSingleton('website_content');
---

<section class="relative z-20 py-15 xl:py-20" aria-labelledby="why-support-heading">
  <div class="container">
    <div class="mx-auto flex max-w-151 flex-col items-center gap-7.5 text-center">
      <div class="flex flex-col items-center gap-4">
        <p class="text-muted-foreground leading-none font-bold uppercase">{eyebrow}</p>
        <h2 id="why-support-heading" class="text-3xl font-bold md:text-5xl">{heading}</h2>
      </div>
      <p class="max-w-119 leading-none">{text}</p>
    </div>
  </div>
</section>
