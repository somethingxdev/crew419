---
import { Image } from 'astro:assets';
import decorBottom from '@/assets/images/decor-bottom.png';
import decorTop from '@/assets/images/decor-top.png';
import bg from '@/assets/images/donate/gift-bg.png';

const features = [
  {
    num: '01',
    title: 'Ministry Infrastructure',
    text: 'Sustains the daily operations and staff that keep Crew419 running – and every trip possible.',
  },
  {
    num: '02',
    title: 'Discipleship & Evangelism',
    text: 'Funds ongoing training and outreach that continues long after a trip ends.',
  },
  {
    num: '03',
    title: 'Trip Scholarships',
    text: 'Gives a teenager or adult who couldn’t otherwise afford it the chance for a life-changing trip.',
  },
  {
    num: '04',
    title: 'Partners on the Ground',
    text: 'Provides medical, educational, food, and spiritual resources — and direct support for local missionaries and church partners serving year-round.',
  },
];
---

<section class="relative z-10 py-15 md:py-30 lg:py-37.5" aria-labelledby="where-gift-goes-heading">
  <div class="absolute inset-0 overflow-hidden">
    <Image src={bg} alt="" widths={[1600, 2400]} class="size-full object-cover object-center" />
    <div class="absolute inset-0 bg-black/10"></div>
  </div>

  <div class="container">
    <div class="relative z-10 flex w-full flex-col justify-between gap-10 xl:flex-row xl:items-start">
      <div class="flex max-w-202 flex-col gap-4 text-cream">
        <p class="leading-none font-bold uppercase opacity-80">Where your gift goes</p>
        <h2 id="where-gift-goes-heading" class="text-3xl font-bold text-shadow-2xs md:text-5xl">Your Trip Fee Covers the Trip. Your Gift Covers the Mission.</h2>
      </div>

      <div class="flex w-full max-w-130 shrink-0 flex-col gap-5">
        {
          features.map((item) => (
            <article class="flex flex-col gap-5 rounded-lg bg-cream p-7.5">
              <div class="flex flex-col gap-3.75">
                <p class="text-primary text-2xl font-bold">{item.num}</p>
                <h3 class="text-2xl font-bold">{item.title}</h3>
              </div>
              <p class="leading-none">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute top-5 left-0 z-10 w-full -translate-y-1/2">
    <Image src={decorTop} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
  <div class="pointer-events-none absolute bottom-5 left-0 z-10 w-full translate-y-[70%]">
    <Image src={decorBottom} alt="" widths={[1600]} class="h-auto w-full" />
  </div>
</section>
