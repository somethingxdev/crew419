---
import { Font } from 'astro:assets';
import Footer from '@/components/base/Footer.astro';
import Header from '@/components/base/Header.astro';
import { getSingleton } from '@/lib/content';
import type { DirectusImage } from '@/lib/directus-loader';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage: DirectusImage;
}

const { title, description, ogImage } = Astro.props;
const { favicon, site_name } = await getSingleton('global');

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type={favicon.type} href={favicon.url} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-sadi-sans" preload />
    <Font cssVariable="--font-arvo" preload />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site_name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="flex flex-col min-h-screen">
      <Header />
      <main class="flex-1 overflow-x-clip">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
