---
import Layout from '@/layouts/Layout.astro';
import Partners from '@/components/churches/Partners.astro';
import Faq from '@/components/home/Faq.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import Impact from '@/components/home/Impact.astro';
import BeyondTheTrip from '@/components/school/BeyondTheTrip.astro';
import SchoolCta from '@/components/school/Cta.astro';
import Hero from '@/components/school/Hero.astro';
import WhyCrew419 from '@/components/school/WhyCrew419.astro';
import WhySchools from '@/components/school/WhySchools.astro';
import { getSingleton } from '@/lib/content';

const { school_seo_title, school_seo_description, school_og_image } = await getSingleton('website_content');
---

<Layout title={school_seo_title} description={school_seo_description} ogImage={school_og_image}>
  <Hero />
  <WhySchools />
  <WhyCrew419 />
  <BeyondTheTrip />
  <HowItWorks page="school" />
  <Impact variant="audience" class="py-30" />
  <Partners where="audience" />
  <Faq page="school" />
  <SchoolCta />
</Layout>
