---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ResourcesCta from '@/components/resources/Cta.astro';
import GuideCards from '@/components/resources/guide/Cards.astro';
import GetYourCopy from '@/components/resources/guide/GetYourCopy.astro';
import GuideHero from '@/components/resources/guide/Hero.astro';
import GuideIntro from '@/components/resources/guide/Intro.astro';

const guides = await getCollection('resources', ({ data }) => data.kind === 'discipleship');
if (guides.length !== 1) throw new Error(`Expected exactly one "discipleship" resource in Directus, found ${guides.length}`);
const [guide] = guides;

const { seo_title, seo_description, og_image, canonical_url } = guide.data;
---

<Layout title={seo_title} description={seo_description} ogImage={og_image} canonical={canonical_url}>
  <GuideHero resource={guide} />
  <GuideCards resource={guide} />
  <GuideIntro resource={guide} />
  <GetYourCopy resource={guide} />
  <ResourcesCta resource={guide} class="py-30" />
</Layout>
