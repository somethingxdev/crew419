---
import Layout from '@/layouts/Layout.astro';
import Partners from '@/components/churches/Partners.astro';
import Faq from '@/components/home/Faq.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import Impact from '@/components/home/Impact.astro';
import IndividualsCta from '@/components/individuals/Cta.astro';
import Hero from '@/components/individuals/Hero.astro';
import UpcomingTrips from '@/components/individuals/UpcomingTrips.astro';
import WhatToExpect from '@/components/individuals/WhatToExpect.astro';
import WhyJoin from '@/components/individuals/WhyJoin.astro';
import { getSingleton } from '@/lib/content';

const { individuals_seo_title, individuals_seo_description, individuals_og_image } = await getSingleton('website_content');
---

<Layout title={individuals_seo_title} description={individuals_seo_description} ogImage={individuals_og_image}>
  <Hero />
  <WhyJoin />
  <UpcomingTrips />
  <WhatToExpect />
  <HowItWorks page="individuals" />
  <Impact variant="audience" class="py-30" />
  <Partners where="audience" />
  <Faq page="individuals" />
  <IndividualsCta />
</Layout>
