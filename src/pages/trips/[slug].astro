---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { getSingleton } from '@/lib/content';
import Layout from '@/layouts/Layout.astro';
import Faq from '@/components/home/Faq.astro';
import RegionAbout from '@/components/regions/About.astro';
import RegionCta from '@/components/regions/Cta.astro';
import RegionHero from '@/components/regions/Hero.astro';
import InTheField from '@/components/regions/InTheField.astro';
import Ministry from '@/components/regions/Ministry.astro';
import Stories from '@/components/regions/Stories.astro';
import AboutMission from '@/components/trip-details/AboutMission.astro';
import AtAGlance from '@/components/trip-details/AtAGlance.astro';
import TripCta from '@/components/trip-details/Cta.astro';
import TripHero from '@/components/trip-details/Hero.astro';
import SimilarTrips from '@/components/trip-details/SimilarTrips.astro';
import WhatsIncluded from '@/components/trip-details/WhatsIncluded.astro';
import YourWeek from '@/components/trip-details/YourWeek.astro';

/**
 * `/trips/[slug]` serves both region pages (`regions.slug`) and trip detail pages (`trips.slug`).
 * `/trips/custom` is a static page and takes precedence.
 */
export async function getStaticPaths() {
  const regions = await getCollection('regions');
  const trips = await getCollection('trips');
  return [
    ...regions.map((region) => ({ params: { slug: region.data.slug }, props: { region } })),
    ...trips.map((trip) => ({ params: { slug: trip.data.slug }, props: { trip } })),
  ];
}

interface Props {
  region?: CollectionEntry<'regions'>;
  trip?: CollectionEntry<'trips'>;
}

const { region, trip } = Astro.props;
const entry = trip ?? region;
if (!entry) throw new Error(`trips/${Astro.params.slug}: neither a region nor a trip`);

// The region a trip belongs to — its "In the field" and stories sections are reused on the trip page.
const tripRegion = trip && (await getEntry(trip.data.region));
if (trip && !tripRegion) throw new Error(`trips/${trip.data.slug}: region "${trip.data.region.id}" is not published`);

// The category carries the shared About the Mission content and the category name in the hero facts.
const tripCategory = trip && (await getEntry(trip.data.category));
if (trip && !tripCategory) throw new Error(`trips/${trip.data.slug}: category "${trip.data.category.id}" does not exist`);

const { seo_title, seo_description } = entry.data;
// Trips and regions have no OG image of their own — the site-wide default is used.
const { og_image } = await getSingleton('global');
---

<Layout title={seo_title} description={seo_description} ogImage={og_image}>
  {
    trip && tripRegion && tripCategory && (
      <>
        <TripHero trip={trip} category={tripCategory} />
        <AtAGlance trip={trip} />
        <AboutMission category={tripCategory} />
        <YourWeek trip={trip} />
        <WhatsIncluded trip={trip} />
        <InTheField bg={tripRegion.data.field_bg} />
        <Stories region={tripRegion} />
        <SimilarTrips trip={trip} />
        <Faq />
        <TripCta />
      </>
    )
  }
  {
    region && (
      <>
        <RegionHero region={region} />
        <RegionAbout region={region} />
        <Ministry region={region} />
        <InTheField bg={region.data.field_bg} />
        <Stories region={region} />
        <RegionCta region={region} />
      </>
    )
  }
</Layout>
