---
import Layout from '@/layouts/Layout.astro';
import Challenge from '@/components/custom/Challenge.astro';
import Cta from '@/components/custom/Cta.astro';
import Difference from '@/components/custom/Difference.astro';
import Hero from '@/components/custom/Hero.astro';
import Included from '@/components/custom/Included.astro';
import PlanningChallenges from '@/components/custom/PlanningChallenges.astro';
import Faq from '@/components/home/Faq.astro';
import FindYourMissionPath from '@/components/home/FindYourMissionPath.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import Impact from '@/components/home/Impact.astro';
import { getSingleton } from '@/lib/content';

const { custom_seo_title, custom_seo_description, custom_og_image } = await getSingleton('website_content');
---

<Layout title={custom_seo_title} description={custom_seo_description} ogImage={custom_og_image}>
  <Hero />
  <Challenge />
  <PlanningChallenges />
  <Difference />
  <FindYourMissionPath variant="custom" class="py-30" />
  <HowItWorks page="custom" />
  <Included />
  <Impact variant="audience" />
  <Faq page="custom" />
  <Cta />
</Layout>
