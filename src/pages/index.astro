---
import Layout from '@/layouts/Layout.astro';
import Cta from '@/components/shared/Cta.astro';
import { CTA } from '@/lib/cta';
import AnsweringTheCall from '@/components/home/AnsweringTheCall.astro';
import Faq from '@/components/home/Faq.astro';
import Hero from '@/components/home/Hero.astro';
import FindYourMissionPath from '@/components/home/FindYourMissionPath.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import Impact from '@/components/home/Impact.astro';
import Statements from '@/components/home/Statements.astro';
import Stories from '@/components/home/Stories.astro';
import WhyCrew419Exists from '@/components/home/WhyCrew419Exists.astro';
import { getSingleton } from '@/lib/content';

const { home_seo_title, home_seo_description, home_og_image, home_stories_eyebrow, home_stories_heading, home_stories_text } = await getSingleton('website_content');
---

<Layout title={home_seo_title} description={home_seo_description} ogImage={home_og_image}>
  <Hero />
  <WhyCrew419Exists />
  <AnsweringTheCall />
  <Statements />
  <HowItWorks />
  <Impact />
  <FindYourMissionPath />
  <Stories eyebrow={home_stories_eyebrow} heading={home_stories_heading} text={home_stories_text} />
  <Faq />
  <Cta {...CTA.home} />
</Layout>
