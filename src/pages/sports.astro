---
import Layout from '@/layouts/Layout.astro';
import Partners from '@/components/churches/Partners.astro';
import Faq from '@/components/home/Faq.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import Impact from '@/components/home/Impact.astro';
import SportsCta from '@/components/sports/Cta.astro';
import Details from '@/components/sports/Details.astro';
import EveryGame from '@/components/sports/EveryGame.astro';
import Hero from '@/components/sports/Hero.astro';
import MoreThanTheGame from '@/components/sports/MoreThanTheGame.astro';
import { getSingleton } from '@/lib/content';

const { sports_seo_title, sports_seo_description, sports_og_image } = await getSingleton('website_content');
---

<Layout title={sports_seo_title} description={sports_seo_description} ogImage={sports_og_image}>
  <Hero />
  <MoreThanTheGame />
  <Details />
  <EveryGame />
  <HowItWorks />
  <Impact heading="Trusted by Churches Across Multiple Countries" class="py-30" />
  <Partners where="audience" />
  <Faq page="sports" />
  <SportsCta />
</Layout>
