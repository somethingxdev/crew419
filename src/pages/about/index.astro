---
import Layout from '@/layouts/Layout.astro';
import Cta from '@/components/about/Cta.astro';
import Founder from '@/components/about/Founder.astro';
import Hero from '@/components/about/Hero.astro';
import HowItStarted from '@/components/about/HowItStarted.astro';
import MissionVisionMotto from '@/components/about/MissionVisionMotto.astro';
import OurIdentity from '@/components/about/OurIdentity.astro';
import StatementOfFaith from '@/components/about/StatementOfFaith.astro';
import Team from '@/components/about/Team.astro';
import TrustedPartners from '@/components/about/TrustedPartners.astro';
import WhatWeBelieve from '@/components/about/WhatWeBelieve.astro';
import { getSingleton } from '@/lib/content';

const { about_seo_title, about_seo_description, about_og_image } = await getSingleton('website_content');
---

<Layout title={about_seo_title} description={about_seo_description} ogImage={about_og_image}>
  <Hero />
  <HowItStarted />
  <OurIdentity />
  <MissionVisionMotto />
  <WhatWeBelieve />
  <Founder />
  <Team />
  <TrustedPartners />
  <StatementOfFaith />
  <Cta />
</Layout>
