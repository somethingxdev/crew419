---
import Layout from '@/layouts/Layout.astro';
import Cta from '@/components/about/Cta.astro';
import Campaign from '@/components/donate/Campaign.astro';
import Hero from '@/components/donate/Hero.astro';
import JoinMission from '@/components/donate/JoinMission.astro';
import WhereGiftGoes from '@/components/donate/WhereGiftGoes.astro';
import WhySupport from '@/components/donate/WhySupport.astro';
import Impact from '@/components/home/Impact.astro';
import Stories from '@/components/regions/Stories.astro';
---

<Layout title="Donate | Crew419">
  <Hero />
  <WhySupport />
  <WhereGiftGoes />
  <Impact class="py-15 xl:py-20" eyebrow="The nets are getting fuller" heading="Lives Changed Through Your Generosity" showMedia={false} />
  <Stories eyebrow="Real Impact" heading="See What Your Support Makes Possible" />
  <Campaign />
  <JoinMission />
  <Cta />
</Layout>
