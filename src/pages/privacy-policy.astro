---
import Layout from '@/layouts/Layout.astro';
import LegalPage from '@/components/legal/Page.astro';
import { getSingleton } from '@/lib/content';

// Legal pages have no CMS entry — description/OG image come from the global site defaults.
const { seo_description, og_image } = await getSingleton('global');
---

<Layout title="Privacy Policy | Crew419" description={seo_description} ogImage={og_image}>
  <LegalPage title="Privacy Policy" />
</Layout>
